<!-- Admin Sidebar Navigation -->
<aside
  x-data="{
    isOpen: window.innerWidth >= 1024,
    activeMenu: '<%= typeof currentPath !== 'undefined' ? currentPath : '' %>',
    masterDataOpen: <%= typeof currentPath !== 'undefined' && (currentPath.includes('faculties') || currentPath.includes('departments') || currentPath.includes('lecturers')) ? 'true' : 'false' %>,
    userManagementOpen: <%= typeof currentPath !== 'undefined' && currentPath.includes('users') ? 'true' : 'false' %>,
    thesisManagementOpen: <%= typeof currentPath !== 'undefined' && currentPath.includes('theses') ? 'true' : 'false' %>
  }"
  x-show="isOpen"
  @toggle-sidebar.window="isOpen = !isOpen"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="-translate-x-full"
  x-transition:enter-end="translate-x-0"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="translate-x-0"
  x-transition:leave-end="-translate-x-full"
  class="fixed lg:static inset-y-0 left-0 z-40 w-64 bg-gradient-to-b from-gray-900 to-gray-800 text-white flex flex-col shadow-2xl"
  @click.away="if (window.innerWidth < 1024) isOpen = false"
>
  <!-- Sidebar Header -->
  <div class="flex items-center justify-between px-6 py-5 border-b border-gray-700">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
        <i data-lucide="graduation-cap" class="w-6 h-6"></i>
      </div>
      <div>
        <h2 class="text-lg font-bold">Thesis Repo</h2>
        <p class="text-xs text-gray-400">Admin Panel</p>
      </div>
    </div>
    <!-- Close button for mobile -->
    <button
      @click="isOpen = false"
      class="lg:hidden text-gray-400 hover:text-white transition"
    >
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>
  </div>

  <!-- Navigation Menu -->
  <nav class="flex-1 overflow-y-auto py-6 px-3 space-y-1">

    <!-- Dashboard -->
    <a
      href="/admin/dashboard"
      class="flex items-center px-4 py-3 rounded-lg transition group"
      :class="activeMenu.includes('dashboard') ? 'bg-blue-600 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
    >
      <i data-lucide="home" class="w-5 h-5 mr-3"></i>
      <span class="font-medium">Dashboard</span>
    </a>

    <!-- Master Data Section -->
    <div class="space-y-1">
      <button
        @click="masterDataOpen = !masterDataOpen"
        class="w-full flex items-center justify-between px-4 py-3 rounded-lg transition group"
        :class="masterDataOpen ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
      >
        <div class="flex items-center">
          <i data-lucide="database" class="w-5 h-5 mr-3"></i>
          <span class="font-medium">Master Data</span>
        </div>
        <i data-lucide="chevron-down" class="w-4 h-4 transition-transform" :class="masterDataOpen ? 'rotate-180' : ''"></i>
      </button>

      <div x-show="masterDataOpen" x-collapse class="ml-4 space-y-1">
        <a
          href="/admin/faculties"
          class="flex items-center px-4 py-2 rounded-lg transition group"
          :class="activeMenu.includes('faculties') ? 'bg-blue-600 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
        >
          <i data-lucide="building-2" class="w-4 h-4 mr-3"></i>
          <span class="text-sm">Faculties</span>
        </a>

        <a
          href="/admin/departments"
          class="flex items-center px-4 py-2 rounded-lg transition group"
          :class="activeMenu.includes('departments') ? 'bg-blue-600 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
        >
          <i data-lucide="folder" class="w-4 h-4 mr-3"></i>
          <span class="text-sm">Departments</span>
        </a>

        <a
          href="/admin/lecturers"
          class="flex items-center px-4 py-2 rounded-lg transition group"
          :class="activeMenu.includes('lecturers') ? 'bg-blue-600 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
        >
          <i data-lucide="users" class="w-4 h-4 mr-3"></i>
          <span class="text-sm">Lecturers</span>
        </a>
      </div>
    </div>

    <!-- User Management Section -->
    <div class="space-y-1">
      <button
        @click="userManagementOpen = !userManagementOpen"
        class="w-full flex items-center justify-between px-4 py-3 rounded-lg transition group"
        :class="userManagementOpen ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
      >
        <div class="flex items-center">
          <i data-lucide="users-2" class="w-5 h-5 mr-3"></i>
          <span class="font-medium">User Management</span>
        </div>
        <i data-lucide="chevron-down" class="w-4 h-4 transition-transform" :class="userManagementOpen ? 'rotate-180' : ''"></i>
      </button>

      <div x-show="userManagementOpen" x-collapse class="ml-4 space-y-1">
        <a
          href="/admin/users?role=STUDENT"
          class="flex items-center px-4 py-2 rounded-lg transition group"
          :class="activeMenu.includes('users') && '<%= typeof role !== 'undefined' ? role : '' %>' === 'STUDENT' ? 'bg-blue-600 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
        >
          <i data-lucide="user" class="w-4 h-4 mr-3"></i>
          <span class="text-sm">Students</span>
        </a>

        <a
          href="/admin/users?role=ADMIN"
          class="flex items-center px-4 py-2 rounded-lg transition group"
          :class="activeMenu.includes('users') && '<%= typeof role !== 'undefined' ? role : '' %>' === 'ADMIN' ? 'bg-blue-600 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
        >
          <i data-lucide="shield" class="w-4 h-4 mr-3"></i>
          <span class="text-sm">Admins</span>
        </a>
      </div>
    </div>

    <!-- Thesis Management Section -->
    <div class="space-y-1">
      <button
        @click="thesisManagementOpen = !thesisManagementOpen"
        class="w-full flex items-center justify-between px-4 py-3 rounded-lg transition group"
        :class="thesisManagementOpen ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
      >
        <div class="flex items-center">
          <i data-lucide="book-open" class="w-5 h-5 mr-3"></i>
          <span class="font-medium">Thesis Management</span>
        </div>
        <i data-lucide="chevron-down" class="w-4 h-4 transition-transform" :class="thesisManagementOpen ? 'rotate-180' : ''"></i>
      </button>

      <div x-show="thesisManagementOpen" x-collapse class="ml-4 space-y-1">
        <a
          href="/admin/theses?status=PENDING"
          class="flex items-center justify-between px-4 py-2 rounded-lg transition group"
          :class="activeMenu.includes('theses') && '<%= typeof status !== 'undefined' ? status : '' %>' === 'PENDING' ? 'bg-blue-600 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
        >
          <div class="flex items-center">
            <i data-lucide="clock" class="w-4 h-4 mr-3"></i>
            <span class="text-sm">Review Queue</span>
          </div>
          <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
            <span class="bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-full">
              <%= pendingCount %>
            </span>
          <% } %>
        </a>

        <a
          href="/admin/theses"
          class="flex items-center px-4 py-2 rounded-lg transition group"
          :class="activeMenu.includes('theses') && '<%= typeof status !== 'undefined' ? status : '' %>' === '' ? 'bg-blue-600 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
        >
          <i data-lucide="book" class="w-4 h-4 mr-3"></i>
          <span class="text-sm">All Theses</span>
        </a>
      </div>
    </div>

    <!-- Statistics -->
    <a
      href="/admin/statistics"
      class="flex items-center px-4 py-3 rounded-lg transition group"
      :class="activeMenu.includes('statistics') ? 'bg-blue-600 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
    >
      <i data-lucide="bar-chart-3" class="w-5 h-5 mr-3"></i>
      <span class="font-medium">Statistics</span>
    </a>

    <!-- Settings -->
    <a
      href="/admin/settings"
      class="flex items-center px-4 py-3 rounded-lg transition group"
      :class="activeMenu.includes('settings') ? 'bg-blue-600 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'"
    >
      <i data-lucide="settings" class="w-5 h-5 mr-3"></i>
      <span class="font-medium">Settings</span>
    </a>

  </nav>

  <!-- User Profile & Logout -->
  <div class="border-t border-gray-700 p-4">
    <div class="flex items-center space-x-3 mb-3 px-2">
      <div class="w-10 h-10 bg-gray-600 rounded-full flex items-center justify-center">
        <i data-lucide="user-circle" class="w-6 h-6"></i>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium truncate">
          <%= typeof user !== 'undefined' && user.name ? user.name : 'Admin User' %>
        </p>
        <p class="text-xs text-gray-400 truncate">
          <%= typeof user !== 'undefined' && user.username ? user.username : 'admin' %>
        </p>
      </div>
    </div>

    <form action="/logout" method="POST" class="w-full">
      <button
        type="submit"
        class="w-full flex items-center justify-center px-4 py-2 bg-red-600 hover:bg-red-700 rounded-lg transition group"
      >
        <i data-lucide="log-out" class="w-4 h-4 mr-2"></i>
        <span class="text-sm font-medium">Logout</span>
      </button>
    </form>
  </div>

</aside>

<!-- Overlay for mobile -->
<div
  x-data="{ isOpen: false }"
  @toggle-sidebar.window="isOpen = !isOpen"
  x-show="isOpen && window.innerWidth < 1024"
  x-transition:enter="transition-opacity ease-linear duration-300"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition-opacity ease-linear duration-300"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 bg-black bg-opacity-50 z-30 lg:hidden"
  @click="$dispatch('toggle-sidebar')"
></div>
