<!-- Breadcrumbs Navigation -->
<% if (typeof breadcrumbs !== 'undefined' && breadcrumbs && breadcrumbs.length > 0) { %>
  <nav class="mb-6" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 text-sm">
      <!-- Home/Dashboard -->
      <li>
        <a
          href="/admin/dashboard"
          class="flex items-center text-gray-500 hover:text-gray-900 transition"
        >
          <i data-lucide="home" class="w-4 h-4"></i>
          <span class="ml-2">Dashboard</span>
        </a>
      </li>

      <!-- Breadcrumb Items -->
      <% breadcrumbs.forEach((crumb, index) => { %>
        <li class="flex items-center">
          <!-- Separator -->
          <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400 mx-1"></i>

          <!-- Last item (current page) -->
          <% if (index === breadcrumbs.length - 1) { %>
            <span class="font-medium text-gray-900">
              <%= crumb.label %>
            </span>
          <% } else { %>
            <!-- Clickable breadcrumb -->
            <a
              href="<%= crumb.url %>"
              class="text-gray-500 hover:text-gray-900 transition"
            >
              <%= crumb.label %>
            </a>
          <% } %>
        </li>
      <% }); %>
    </ol>
  </nav>
<% } %>
