<!-- Admin Top Bar -->
<header
  x-data="{
    userDropdownOpen: false,
    notificationDropdownOpen: false
  }"
  class="sticky top-0 z-30 bg-white border-b border-gray-200 shadow-sm"
>
  <div class="flex items-center justify-between px-4 lg:px-8 py-4">

    <!-- Left: Toggle Sidebar & Page Title -->
    <div class="flex items-center space-x-4">
      <!-- Mobile Sidebar Toggle -->
      <button
        @click="$dispatch('toggle-sidebar')"
        class="lg:hidden text-gray-600 hover:text-gray-900 transition"
        aria-label="Toggle Sidebar"
      >
        <i data-lucide="menu" class="w-6 h-6"></i>
      </button>

      <!-- Page Title -->
      <div>
        <h1 class="text-xl lg:text-2xl font-bold text-gray-900">
          <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin Panel' %>
        </h1>
        <% if (typeof pageSubtitle !== 'undefined' && pageSubtitle) { %>
          <p class="text-sm text-gray-500 mt-0.5"><%= pageSubtitle %></p>
        <% } %>
      </div>
    </div>

    <!-- Right: Notifications & User Dropdown -->
    <div class="flex items-center space-x-3">

      <!-- Notification Icon -->
      <div class="relative">
        <button
          @click="notificationDropdownOpen = !notificationDropdownOpen"
          class="relative p-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition"
          aria-label="Notifications"
        >
          <i data-lucide="bell" class="w-5 h-5"></i>

          <!-- Notification Badge -->
          <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
            <span class="absolute top-1 right-1 flex h-4 w-4">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-4 w-4 bg-red-500 text-white text-xs items-center justify-center font-bold">
                <%= pendingCount > 9 ? '9+' : pendingCount %>
              </span>
            </span>
          <% } %>
        </button>

        <!-- Notification Dropdown -->
        <div
          x-show="notificationDropdownOpen"
          @click.away="notificationDropdownOpen = false"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="transform opacity-0 scale-95"
          x-transition:enter-end="transform opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-75"
          x-transition:leave-start="transform opacity-100 scale-100"
          x-transition:leave-end="transform opacity-0 scale-95"
          class="absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-xl border border-gray-200 overflow-hidden"
          style="display: none;"
        >
          <!-- Dropdown Header -->
          <div class="bg-gray-50 px-4 py-3 border-b border-gray-200">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-semibold text-gray-900">Notifications</h3>
              <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2 py-1 rounded-full">
                  <%= pendingCount %> new
                </span>
              <% } %>
            </div>
          </div>

          <!-- Notification List -->
          <div class="max-h-96 overflow-y-auto">
            <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
              <a href="/admin/theses?status=PENDING" class="block px-4 py-3 hover:bg-gray-50 transition border-b border-gray-100">
                <div class="flex items-start space-x-3">
                  <div class="flex-shrink-0 w-10 h-10 bg-yellow-100 rounded-full flex items-center justify-center">
                    <i data-lucide="clock" class="w-5 h-5 text-yellow-600"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900">Pending Review</p>
                    <p class="text-xs text-gray-500 mt-1">
                      <%= pendingCount %> <%= pendingCount === 1 ? 'thesis' : 'theses' %> waiting for review
                    </p>
                    <p class="text-xs text-gray-400 mt-1">Click to view</p>
                  </div>
                </div>
              </a>
            <% } else { %>
              <div class="px-4 py-8 text-center">
                <i data-lucide="inbox" class="w-12 h-12 text-gray-300 mx-auto mb-2"></i>
                <p class="text-sm text-gray-500">No new notifications</p>
              </div>
            <% } %>
          </div>

          <!-- View All Link -->
          <div class="bg-gray-50 px-4 py-2 border-t border-gray-200">
            <a href="/admin/theses" class="text-sm text-blue-600 hover:text-blue-800 font-medium">
              View all theses →
            </a>
          </div>
        </div>
      </div>

      <!-- User Dropdown -->
      <div class="relative">
        <button
          @click="userDropdownOpen = !userDropdownOpen"
          class="flex items-center space-x-3 p-2 hover:bg-gray-100 rounded-lg transition"
          aria-label="User Menu"
        >
          <div class="hidden md:block text-right">
            <p class="text-sm font-medium text-gray-900">
              <%= typeof user !== 'undefined' && user.name ? user.name : 'Admin User' %>
            </p>
            <p class="text-xs text-gray-500">
              <%= typeof user !== 'undefined' && user.role ? user.role : 'ADMIN' %>
            </p>
          </div>
          <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-white font-bold">
            <%= typeof user !== 'undefined' && user.name ? user.name.charAt(0).toUpperCase() : 'A' %>
          </div>
          <i data-lucide="chevron-down" class="w-4 h-4 text-gray-500"></i>
        </button>

        <!-- User Dropdown Menu -->
        <div
          x-show="userDropdownOpen"
          @click.away="userDropdownOpen = false"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="transform opacity-0 scale-95"
          x-transition:enter-end="transform opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-75"
          x-transition:leave-start="transform opacity-100 scale-100"
          x-transition:leave-end="transform opacity-0 scale-95"
          class="absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-xl border border-gray-200 overflow-hidden"
          style="display: none;"
        >
          <!-- User Info (Mobile) -->
          <div class="md:hidden px-4 py-3 border-b border-gray-200 bg-gray-50">
            <p class="text-sm font-medium text-gray-900">
              <%= typeof user !== 'undefined' && user.name ? user.name : 'Admin User' %>
            </p>
            <p class="text-xs text-gray-500 mt-0.5">
              <%= typeof user !== 'undefined' && user.username ? user.username : 'admin' %>
            </p>
          </div>

          <!-- Menu Items -->
          <div class="py-1">
            <a
              href="/admin/profile"
              class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition"
            >
              <i data-lucide="user" class="w-4 h-4 mr-3 text-gray-500"></i>
              My Profile
            </a>
            <a
              href="/admin/settings"
              class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition"
            >
              <i data-lucide="settings" class="w-4 h-4 mr-3 text-gray-500"></i>
              Settings
            </a>
          </div>

          <div class="border-t border-gray-200 py-1">
            <form action="/logout" method="POST">
              <button
                type="submit"
                class="w-full flex items-center px-4 py-2 text-sm text-red-700 hover:bg-red-50 transition"
              >
                <i data-lucide="log-out" class="w-4 h-4 mr-3 text-red-500"></i>
                Logout
              </button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</header>
