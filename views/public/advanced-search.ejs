<!-- Advanced Search Page -->
<div class="min-h-screen bg-gray-50">
  <!-- Page Header -->
  <div class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold mb-4">
        <i class="fas fa-search mr-3"></i>Advanced Search
      </h1>
      <p class="text-blue-100 text-lg">
        Search across multiple fields with advanced filters
      </p>
    </div>
  </div>

  <!-- Search Form -->
  <div class="container mx-auto px-4 py-8">
    <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
      <form method="GET" action="/search/advanced">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Title Search -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-heading mr-2 text-blue-600"></i>Title
            </label>
            <div class="flex gap-2">
              <input type="text" name="title" value="<%= searchParams.title %>" placeholder="Enter thesis title" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <select name="titleMatch" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="contains" <%= searchParams.titleMatch === 'contains' ? 'selected' : '' %>>Contains</option>
                <option value="exact" <%= searchParams.titleMatch === 'exact' ? 'selected' : '' %>>Exact</option>
              </select>
            </div>
          </div>

          <!-- Author Search -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-user mr-2 text-blue-600"></i>Author
            </label>
            <div class="flex gap-2">
              <input type="text" name="author" value="<%= searchParams.author %>" placeholder="Enter author name" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <select name="authorMatch" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="contains" <%= searchParams.authorMatch === 'contains' ? 'selected' : '' %>>Contains</option>
                <option value="exact" <%= searchParams.authorMatch === 'exact' ? 'selected' : '' %>>Exact</option>
              </select>
            </div>
          </div>

          <!-- Abstract Search -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-align-left mr-2 text-blue-600"></i>Abstract
            </label>
            <div class="flex gap-2">
              <input type="text" name="abstract" value="<%= searchParams.abstract %>" placeholder="Enter keywords from abstract" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <select name="abstractMatch" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="contains" <%= searchParams.abstractMatch === 'contains' ? 'selected' : '' %>>Contains</option>
                <option value="exact" <%= searchParams.abstractMatch === 'exact' ? 'selected' : '' %>>Exact</option>
              </select>
            </div>
          </div>

          <!-- Keywords Search -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-tags mr-2 text-blue-600"></i>Keywords
            </label>
            <div class="flex gap-2">
              <input type="text" name="keywords" value="<%= searchParams.keywords %>" placeholder="Enter keywords" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <select name="keywordsMatch" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="contains" <%= searchParams.keywordsMatch === 'contains' ? 'selected' : '' %>>Contains</option>
                <option value="exact" <%= searchParams.keywordsMatch === 'exact' ? 'selected' : '' %>>Exact</option>
              </select>
            </div>
          </div>

          <!-- Field Operator -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-random mr-2 text-blue-600"></i>Field Operator
            </label>
            <select name="fieldOperator" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <option value="AND" <%= searchParams.fieldOperator === 'AND' ? 'selected' : '' %>>Match ALL fields (AND)</option>
              <option value="OR" <%= searchParams.fieldOperator === 'OR' ? 'selected' : '' %>>Match ANY field (OR)</option>
            </select>
          </div>

          <!-- Research Method -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-flask mr-2 text-blue-600"></i>Research Method
            </label>
            <select name="researchMethod" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <option value="">All Methods</option>
              <% researchMethods.forEach(method => { %>
                <option value="<%= method.value %>" <%= searchParams.researchMethod === method.value ? 'selected' : '' %>>
                  <%= method.label %>
                </option>
              <% }); %>
            </select>
          </div>

          <!-- Faculty -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-university mr-2 text-blue-600"></i>Faculty
            </label>
            <select name="faculty" id="faculty-select" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <option value="">All Faculties</option>
              <% faculties.forEach(faculty => { %>
                <option value="<%= faculty.id %>" <%= searchParams.facultyId === faculty.id ? 'selected' : '' %>>
                  <%= faculty.name %>
                </option>
              <% }); %>
            </select>
          </div>

          <!-- Department -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-building mr-2 text-blue-600"></i>Department
            </label>
            <select name="department" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <option value="">All Departments</option>
              <% faculties.forEach(faculty => { %>
                <% faculty.departments.forEach(dept => { %>
                  <option value="<%= dept.id %>" <%= searchParams.departmentId === dept.id ? 'selected' : '' %> data-faculty="<%= faculty.id %>">
                    <%= dept.name %>
                  </option>
                <% }); %>
              <% }); %>
            </select>
          </div>

          <!-- Year Range -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-calendar-alt mr-2 text-blue-600"></i>Year Range
            </label>
            <div class="flex gap-2">
              <select name="yearFrom" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">From</option>
                <% availableYears.forEach(year => { %>
                  <option value="<%= year %>" <%= searchParams.yearFrom === year ? 'selected' : '' %>><%= year %></option>
                <% }); %>
              </select>
              <span class="flex items-center text-gray-500">-</span>
              <select name="yearTo" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">To</option>
                <% availableYears.forEach(year => { %>
                  <option value="<%= year %>" <%= searchParams.yearTo === year ? 'selected' : '' %>><%= year %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <!-- Sort By -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-sort mr-2 text-blue-600"></i>Sort By
            </label>
            <select name="sort" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <option value="relevance" <%= searchParams.sort === 'relevance' ? 'selected' : '' %>>Relevance</option>
              <option value="newest" <%= searchParams.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
              <option value="oldest" <%= searchParams.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
              <option value="title" <%= searchParams.sort === 'title' ? 'selected' : '' %>>Title (A-Z)</option>
              <option value="author" <%= searchParams.sort === 'author' ? 'selected' : '' %>>Author (A-Z)</option>
              <option value="year" <%= searchParams.sort === 'year' ? 'selected' : '' %>>Year</option>
              <option value="popular" <%= searchParams.sort === 'popular' ? 'selected' : '' %>>Most Popular</option>
            </select>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-4 mt-8">
          <button type="submit" class="flex-1 px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition">
            <i class="fas fa-search mr-2"></i>Search
          </button>
          <a href="/search/advanced" class="px-6 py-3 border border-gray-300 rounded-lg font-semibold text-gray-700 hover:bg-gray-50 transition">
            <i class="fas fa-redo mr-2"></i>Reset
          </a>
        </div>
      </form>
    </div>

    <!-- Search Results -->
    <% if (results.length > 0 || (searchParams.title || searchParams.author || searchParams.abstract || searchParams.keywords)) { %>
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-gray-900">
          Search Results
          <span class="text-blue-600">(<%= totalCount.toLocaleString() %>)</span>
        </h2>
      </div>

      <% if (results.length > 0) { %>
        <div class="space-y-6">
          <% results.forEach(thesis => { %>
            <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow p-6">
              <!-- Title -->
              <a href="/thesis/<%= thesis.id %>" class="block group mb-3">
                <h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
                  <%- thesis.highlightedTitle %>
                </h3>
              </a>

              <!-- Metadata -->
              <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600 mb-3">
                <div><i class="fas fa-user mr-1"></i><%= thesis.authorName %></div>
                <div><i class="fas fa-building mr-1"></i><%= thesis.department.name %></div>
                <div><i class="fas fa-calendar mr-1"></i><%= thesis.graduationYear %></div>
                <div><i class="fas fa-flask mr-1"></i>
                  <% if (thesis.researchMethod === 'QUALITATIVE') { %>Kualitatif
                  <% } else if (thesis.researchMethod === 'QUANTITATIVE') { %>Kuantitatif
                  <% } else if (thesis.researchMethod === 'MIXED_METHOD') { %>Mix-method
                  <% } else { %>Lainnya<% } %>
                </div>
              </div>

              <!-- Abstract Excerpt -->
              <% if (thesis.highlightedAbstract) { %>
                <p class="text-gray-700 mb-3"><%- thesis.highlightedAbstract %></p>
              <% } %>

              <!-- Keywords -->
              <% if (thesis.highlightedKeywords && thesis.highlightedKeywords.length > 0) { %>
                <div class="flex flex-wrap gap-2">
                  <% thesis.highlightedKeywords.slice(0, 5).forEach(keyword => { %>
                    <span class="inline-block px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs">
                      <%- keyword.highlighted %>
                    </span>
                  <% }); %>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div class="mt-8 flex justify-center">
            <nav class="inline-flex rounded-lg shadow-sm">
              <% if (hasPrevPage) { %>
                <a href="?<%= new URLSearchParams({...searchParams, page: currentPage - 1}).toString() %>" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-50">
                  Previous
                </a>
              <% } %>

              <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                <a href="?<%= new URLSearchParams({...searchParams, page: i}).toString() %>" class="px-4 py-2 text-sm font-medium <%= i === currentPage ? 'bg-blue-600 text-white' : 'text-gray-700 bg-white hover:bg-gray-50' %> border-t border-b border-gray-300">
                  <%= i %>
                </a>
              <% } %>

              <% if (hasNextPage) { %>
                <a href="?<%= new URLSearchParams({...searchParams, page: currentPage + 1}).toString() %>" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-50">
                  Next
                </a>
              <% } %>
            </nav>
          </div>
        <% } %>
      <% } else { %>
        <!-- Empty State -->
        <div class="bg-white rounded-lg shadow-sm p-12 text-center">
          <i class="fas fa-search text-6xl text-gray-300 mb-4"></i>
          <p class="text-xl text-gray-500 mb-2">No results found</p>
          <p class="text-gray-400">Try adjusting your search criteria</p>
        </div>
      <% } %>
    <% } %>
  </div>
</div>
