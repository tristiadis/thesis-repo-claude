<!-- Browse by Research Method Page -->
<div class="min-h-screen bg-gray-50">
  <!-- Page Header -->
  <div class="bg-gradient-to-r from-purple-600 to-purple-800 text-white py-12">
    <div class="container mx-auto px-4">
      <!-- Breadcrumb -->
      <div class="text-sm mb-4">
        <a href="/" class="hover:text-purple-200 transition">
          <i class="fas fa-home mr-1"></i>Home
        </a>
        <span class="mx-2">/</span>
        <span>Browse by Research Method</span>
      </div>

      <h1 class="text-4xl font-bold mb-4">Browse by Research Method</h1>
      <p class="text-purple-100 text-lg">
        Explore theses organized by research methodology
      </p>
    </div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 py-12">
    <% if (methods.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <% methods.forEach(method => { %>
          <a href="/browse/research-methods/<%= method.value.toLowerCase() %>" class="block group">
            <div class="bg-white rounded-xl shadow-md hover:shadow-2xl transition-all p-8 transform hover:-translate-y-2">
              <!-- Icon -->
              <div class="mb-6">
                <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center group-hover:bg-purple-600 transition-colors">
                  <% if (method.value === 'QUALITATIVE') { %>
                    <i class="fas fa-comments text-2xl text-purple-600 group-hover:text-white transition-colors"></i>
                  <% } else if (method.value === 'QUANTITATIVE') { %>
                    <i class="fas fa-chart-bar text-2xl text-purple-600 group-hover:text-white transition-colors"></i>
                  <% } else if (method.value === 'MIXED_METHOD') { %>
                    <i class="fas fa-layer-group text-2xl text-purple-600 group-hover:text-white transition-colors"></i>
                  <% } else { %>
                    <i class="fas fa-flask text-2xl text-purple-600 group-hover:text-white transition-colors"></i>
                  <% } %>
                </div>
              </div>

              <!-- Method Name -->
              <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-purple-600 transition-colors">
                <%= method.label %>
              </h3>

              <!-- Statistics -->
              <div class="flex items-center gap-2 text-gray-600 mb-4">
                <i class="fas fa-book text-purple-600"></i>
                <span class="font-semibold text-xl"><%= method.thesisCount.toLocaleString() %></span>
                <span class="text-sm"><%= method.thesisCount === 1 ? 'thesis' : 'theses' %></span>
              </div>

              <!-- Button -->
              <div class="flex items-center text-purple-600 group-hover:text-purple-700 font-medium">
                Browse <i class="fas fa-arrow-right ml-2 transform group-hover:translate-x-1 transition-transform"></i>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <!-- Empty State -->
      <div class="text-center py-16">
        <i class="fas fa-flask text-6xl text-gray-300 mb-4"></i>
        <p class="text-xl text-gray-500">No research methods found</p>
      </div>
    <% } %>
  </div>
</div>
