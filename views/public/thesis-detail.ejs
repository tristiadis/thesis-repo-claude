<!-- SEO Meta Tags -->
<%
  // This will be injected into the head section via layout
  const metaTags = `
    <meta name="description" content="${seo.description.replace(/"/g, '&quot;')}">
    <meta name="keywords" content="${seo.keywords}">
    <link rel="canonical" href="${seo.url}">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="${seo.url}">
    <meta property="og:title" content="${seo.title.replace(/"/g, '&quot;')}">
    <meta property="og:description" content="${seo.description.replace(/"/g, '&quot;')}">
    ${seo.image ? `<meta property="og:image" content="${seo.image}">` : ''}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="${seo.url}">
    <meta property="twitter:title" content="${seo.title.replace(/"/g, '&quot;')}">
    <meta property="twitter:description" content="${seo.description.replace(/"/g, '&quot;')}">
    ${seo.image ? `<meta property="twitter:image" content="${seo.image}">` : ''}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      "name": "${thesis.title.replace(/"/g, '\\"')}",
      "author": {
        "@type": "Person",
        "name": "${thesis.submitter.name.replace(/"/g, '\\"')}"
      },
      "datePublished": "${thesis.publishedAt ? thesis.publishedAt.toISOString() : ''}",
      "about": "${(thesis.abstractId || '').substring(0, 200).replace(/"/g, '\\"')}",
      "keywords": "${thesis.keywords || ''}",
      "url": "${seo.url}"
    }
    </script>
  `;
%>

<!-- Thesis Detail Page -->
<div class="min-h-screen bg-gray-50">
  <!-- Header Section -->
  <div class="bg-gradient-to-r from-indigo-600 to-purple-700 text-white py-12">
    <div class="container mx-auto px-4">
      <!-- Breadcrumb -->
      <div class="text-sm mb-4 opacity-90">
        <a href="/" class="hover:text-indigo-200 transition">
          <i class="fas fa-home mr-1"></i>Home
        </a>
        <span class="mx-2">/</span>
        <a href="/browse/faculties/<%= thesis.department.facultyId %>" class="hover:text-indigo-200 transition">
          <%= thesis.department.faculty.name %>
        </a>
        <span class="mx-2">/</span>
        <a href="/browse/departments/<%= thesis.departmentId %>" class="hover:text-indigo-200 transition">
          <%= thesis.department.name %>
        </a>
        <span class="mx-2">/</span>
        <span>Thesis Detail</span>
      </div>

      <!-- Title -->
      <h1 class="text-4xl font-bold mb-4 leading-tight">
        <%= thesis.title %>
      </h1>

      <!-- English Title if available -->
      <% if (thesis.titleEn) { %>
        <h2 class="text-2xl text-indigo-100 mb-4 italic">
          <%= thesis.titleEn %>
        </h2>
      <% } %>

      <!-- Metadata -->
      <div class="flex flex-wrap items-center gap-4 text-indigo-100 mb-6">
        <div class="flex items-center gap-2">
          <i class="fas fa-user"></i>
          <span><%= thesis.submitter.name %></span>
        </div>
        <span class="text-indigo-300">•</span>
        <div class="flex items-center gap-2">
          <i class="fas fa-id-card"></i>
          <span><%= thesis.submitter.studentId || 'N/A' %></span>
        </div>
        <span class="text-indigo-300">•</span>
        <div class="flex items-center gap-2">
          <i class="fas fa-calendar"></i>
          <span><%= thesis.graduationYear %></span>
        </div>
        <% if (thesis.defenseDate) { %>
          <span class="text-indigo-300">•</span>
          <div class="flex items-center gap-2">
            <i class="fas fa-calendar-check"></i>
            <span>Defended: <%= new Date(thesis.defenseDate).toLocaleDateString() %></span>
          </div>
        <% } %>
      </div>

      <div class="flex flex-wrap items-center gap-4 text-indigo-100">
        <div class="flex items-center gap-2">
          <i class="fas fa-building"></i>
          <span><%= thesis.department.name %></span>
        </div>
        <span class="text-indigo-300">•</span>
        <div class="flex items-center gap-2">
          <i class="fas fa-university"></i>
          <span><%= thesis.department.faculty.name %></span>
        </div>
      </div>

      <!-- Statistics -->
      <div class="flex gap-4 mt-6">
        <div class="bg-white bg-opacity-20 backdrop-blur-sm rounded-lg px-4 py-2 flex items-center gap-2">
          <i class="fas fa-eye text-xl"></i>
          <div>
            <div class="font-bold text-lg"><%= (thesis.viewCount + 1).toLocaleString() %></div>
            <div class="text-xs text-indigo-200">Views</div>
          </div>
        </div>
        <div class="bg-white bg-opacity-20 backdrop-blur-sm rounded-lg px-4 py-2 flex items-center gap-2">
          <i class="fas fa-download text-xl"></i>
          <div>
            <div class="font-bold text-lg"><%= (thesis.downloadCount || 0).toLocaleString() %></div>
            <div class="text-xs text-indigo-200">Downloads</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Left Column (Main Content) -->
      <div class="lg:w-2/3">
        <!-- Abstract Section -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Abstract</h2>

          <!-- Tabbed Interface (if English abstract available) -->
          <% if (thesis.abstractEn) { %>
            <div class="mb-4" x-data="{ tab: 'id' }">
              <div class="flex gap-2 border-b border-gray-200">
                <button
                  @click="tab = 'id'"
                  :class="tab === 'id' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-gray-600'"
                  class="px-4 py-2 border-b-2 font-semibold transition"
                >
                  Bahasa Indonesia
                </button>
                <button
                  @click="tab = 'en'"
                  :class="tab === 'en' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-gray-600'"
                  class="px-4 py-2 border-b-2 font-semibold transition"
                >
                  English
                </button>
              </div>

              <div class="mt-4">
                <div x-show="tab === 'id'" class="text-gray-700 leading-relaxed whitespace-pre-line">
                  <%= thesis.abstractId || 'No abstract available.' %>
                </div>
                <div x-show="tab === 'en'" class="text-gray-700 leading-relaxed whitespace-pre-line" style="display: none;">
                  <%= thesis.abstractEn %>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="text-gray-700 leading-relaxed whitespace-pre-line">
              <%= thesis.abstractId || 'No abstract available.' %>
            </div>
          <% } %>
        </div>

        <!-- Keywords Section -->
        <% if (thesis.keywords) { %>
          <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Keywords</h2>
            <div class="flex flex-wrap gap-2">
              <% thesis.keywords.split(',').forEach(keyword => { %>
                <a
                  href="/search?q=<%= encodeURIComponent(keyword.trim()) %>"
                  class="px-4 py-2 bg-indigo-100 text-indigo-700 rounded-full hover:bg-indigo-200 transition-colors"
                >
                  <i class="fas fa-tag mr-1"></i><%= keyword.trim() %>
                </a>
              <% }); %>
            </div>
          </div>
        <% } %>

        <!-- Advisors & Examiners Section -->
        <% if (team.length > 0) { %>
          <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Advisors & Examiners</h2>
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="border-b border-gray-200">
                    <th class="text-left py-3 px-4 text-gray-700 font-semibold">Role</th>
                    <th class="text-left py-3 px-4 text-gray-700 font-semibold">Name</th>
                    <th class="text-left py-3 px-4 text-gray-700 font-semibold">Department</th>
                  </tr>
                </thead>
                <tbody>
                  <% team.forEach((member, index) => { %>
                    <tr class="<%= index % 2 === 0 ? 'bg-gray-50' : '' %> hover:bg-indigo-50 transition">
                      <td class="py-3 px-4 text-gray-600"><%= member.role %></td>
                      <td class="py-3 px-4 font-medium text-gray-900"><%= member.name %></td>
                      <td class="py-3 px-4 text-gray-600"><%= member.department || 'N/A' %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>

        <!-- Citation Section -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Citation</h2>

          <div class="bg-gray-50 rounded-lg p-4 mb-4 font-mono text-sm text-gray-700 border border-gray-200">
            <%= citation %>
          </div>

          <div class="flex flex-wrap gap-2">
            <button
              onclick="copyCitation()"
              class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition-colors"
            >
              <i class="fas fa-copy mr-2"></i>Copy Citation
            </button>
            <a
              href="/thesis/<%= thesis.id %>/export/ris"
              class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-semibold transition-colors inline-block"
            >
              <i class="fas fa-file-download mr-2"></i>Export RIS
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column (Sidebar) -->
      <div class="lg:w-1/3">
        <!-- Files Section -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6 sticky top-4">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Files</h2>

          <% if (thesis.files.length > 0) { %>
            <div class="space-y-4">
              <% thesis.files.forEach(file => { %>
                <div class="border border-gray-200 rounded-lg p-4 hover:border-indigo-300 transition">
                  <!-- File Icon & Type -->
                  <div class="flex items-start gap-3 mb-3">
                    <div class="flex-shrink-0 w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                      <i class="fas fa-file-pdf text-indigo-600 text-xl"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="font-semibold text-gray-900 truncate">
                        <%= file.fileType || 'Document' %>
                      </div>
                      <div class="text-sm text-gray-500">
                        <%= (file.fileSize / 1024 / 1024).toFixed(2) %> MB
                      </div>
                    </div>
                  </div>

                  <!-- Access Status -->
                  <% if (file.accessStatus === 'public') { %>
                    <div class="flex gap-2">
                      <a
                        href="/upload/preview/<%= file.id %>"
                        target="_blank"
                        class="flex-1 px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-center text-sm font-semibold transition-colors"
                      >
                        <i class="fas fa-eye mr-1"></i>Preview
                      </a>
                      <a
                        href="/upload/download/<%= file.id %>"
                        class="flex-1 px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-center text-sm font-semibold transition-colors"
                      >
                        <i class="fas fa-download mr-1"></i>Download
                      </a>
                    </div>
                    <div class="mt-2 flex items-center text-xs text-green-600">
                      <i class="fas fa-check-circle mr-1"></i>
                      <span>Public Access</span>
                    </div>
                  <% } else if (file.accessStatus === 'embargoed') { %>
                    <div class="px-3 py-2 bg-yellow-50 border border-yellow-200 rounded-lg text-center">
                      <div class="text-sm font-semibold text-yellow-800 mb-1">
                        <i class="fas fa-clock mr-1"></i>Embargoed
                      </div>
                      <div class="text-xs text-yellow-700">
                        <%= file.embargoMessage %>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="px-3 py-2 bg-red-50 border border-red-200 rounded-lg text-center">
                      <div class="text-sm font-semibold text-red-800">
                        <i class="fas fa-lock mr-1"></i>Access Restricted
                      </div>
                    </div>
                  <% } %>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="text-center text-gray-500 py-8">
              <i class="fas fa-file text-4xl text-gray-300 mb-2"></i>
              <p>No files available</p>
            </div>
          <% } %>
        </div>

        <!-- Share Section -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Share</h3>

          <div class="space-y-2">
            <a
              href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(seo.url) %>"
              target="_blank"
              class="block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-center font-semibold transition-colors"
            >
              <i class="fab fa-facebook mr-2"></i>Facebook
            </a>
            <a
              href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(seo.url) %>&text=<%= encodeURIComponent(thesis.title) %>"
              target="_blank"
              class="block px-4 py-2 bg-sky-500 hover:bg-sky-600 text-white rounded-lg text-center font-semibold transition-colors"
            >
              <i class="fab fa-twitter mr-2"></i>Twitter
            </a>
            <a
              href="https://wa.me/?text=<%= encodeURIComponent(thesis.title + ' - ' + seo.url) %>"
              target="_blank"
              class="block px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-center font-semibold transition-colors"
            >
              <i class="fab fa-whatsapp mr-2"></i>WhatsApp
            </a>
            <button
              onclick="copyLink()"
              class="w-full px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-semibold transition-colors"
            >
              <i class="fas fa-link mr-2"></i>Copy Link
            </button>
          </div>

          <div class="mt-4 pt-4 border-t border-gray-200">
            <a href="#" class="text-sm text-gray-600 hover:text-indigo-600 transition">
              <i class="fas fa-flag mr-1"></i>Report an issue
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Copy citation to clipboard
function copyCitation() {
  const citation = `<%= citation.replace(/'/g, "\\'") %>`;
  navigator.clipboard.writeText(citation).then(() => {
    alert('Citation copied to clipboard!');
  }).catch(err => {
    console.error('Failed to copy citation:', err);
  });
}

// Copy page link to clipboard
function copyLink() {
  const url = '<%= seo.url %>';
  navigator.clipboard.writeText(url).then(() => {
    alert('Link copied to clipboard!');
  }).catch(err => {
    console.error('Failed to copy link:', err);
  });
}
</script>
