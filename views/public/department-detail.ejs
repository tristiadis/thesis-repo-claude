<!-- Department Detail Page -->
<div class="min-h-screen bg-gray-50">
  <!-- Page Header -->
  <div class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-12">
    <div class="container mx-auto px-4">
      <!-- Breadcrumb -->
      <div class="text-sm mb-4">
        <a href="/" class="hover:text-blue-200 transition">
          <i class="fas fa-home mr-1"></i>Home
        </a>
        <span class="mx-2">/</span>
        <a href="/browse/faculties" class="hover:text-blue-200 transition">
          Browse
        </a>
        <span class="mx-2">/</span>
        <a href="/browse/faculties/<%= faculty.id %>" class="hover:text-blue-200 transition">
          <%= faculty.name %>
        </a>
        <span class="mx-2">/</span>
        <span><%= department.name %></span>
      </div>

      <div class="flex items-start justify-between">
        <div class="flex-1">
          <h1 class="text-4xl font-bold mb-4"><%= department.name %></h1>
          <% if (department.code) { %>
            <p class="text-blue-100 text-lg mb-2">Code: <%= department.code %></p>
          <% } %>
          <p class="text-blue-100">
            <i class="fas fa-university mr-2"></i><%= faculty.name %>
          </p>
        </div>
        <div class="hidden lg:block ml-8">
          <i class="fas fa-building text-8xl text-blue-300 opacity-50"></i>
        </div>
      </div>

      <!-- Total Count -->
      <div class="mt-6 bg-white bg-opacity-20 backdrop-blur-sm rounded-lg p-4 inline-block">
        <div class="text-3xl font-bold mb-1">
          <%= totalCount.toLocaleString() %>
        </div>
        <div class="text-blue-100">
          <%= totalCount === 1 ? 'Thesis' : 'Theses' %>
        </div>
      </div>
    </div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Filter Sidebar -->
      <aside class="lg:w-64 flex-shrink-0">
        <div class="bg-white rounded-lg shadow-md p-6 sticky top-4">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-bold text-gray-900">Filters</h2>
            <% if (filters.graduationYear || filters.sort !== 'year') { %>
              <a href="/browse/departments/<%= department.id %>" class="text-sm text-blue-600 hover:text-blue-800">
                Clear
              </a>
            <% } %>
          </div>

          <!-- Sort Options -->
          <div class="mb-6">
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Sort By
            </label>
            <select
              name="sort"
              onchange="this.form.submit()"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              form="filter-form"
            >
              <option value="year" <%= filters.sort === 'year' ? 'selected' : '' %>>Year (Newest)</option>
              <option value="title" <%= filters.sort === 'title' ? 'selected' : '' %>>Title (A-Z)</option>
              <option value="popular" <%= filters.sort === 'popular' ? 'selected' : '' %>>Most Viewed</option>
            </select>
          </div>

          <!-- Year Filter -->
          <div class="mb-6">
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Graduation Year
            </label>
            <div class="space-y-2 max-h-64 overflow-y-auto">
              <% availableYears.forEach(yearObj => { %>
                <label class="flex items-center justify-between hover:bg-gray-50 p-2 rounded cursor-pointer">
                  <div class="flex items-center">
                    <input
                      type="radio"
                      name="year"
                      value="<%= yearObj.year %>"
                      <%= filters.graduationYear === yearObj.year ? 'checked' : '' %>
                      onchange="document.getElementById('filter-form').submit()"
                      form="filter-form"
                      class="mr-2"
                    />
                    <span class="text-sm text-gray-700"><%= yearObj.year %></span>
                  </div>
                  <span class="text-xs text-gray-500">(<%= yearObj.count %>)</span>
                </label>
              <% }); %>
              <% if (filters.graduationYear) { %>
                <label class="flex items-center hover:bg-gray-50 p-2 rounded cursor-pointer">
                  <input
                    type="radio"
                    name="year"
                    value=""
                    onchange="document.getElementById('filter-form').submit()"
                    form="filter-form"
                    class="mr-2"
                  />
                  <span class="text-sm text-blue-600 font-semibold">All Years</span>
                </label>
              <% } %>
            </div>
          </div>

          <!-- Hidden Filter Form -->
          <form id="filter-form" action="/browse/departments/<%= department.id %>" method="GET" style="display: none;"></form>
        </div>
      </aside>

      <!-- Theses List -->
      <main class="flex-1">
        <% if (theses.length > 0) { %>
          <!-- Results Info -->
          <div class="mb-4 flex items-center justify-between">
            <div class="text-sm text-gray-600">
              Showing <%= ((currentPage - 1) * limit + 1).toLocaleString() %>-<%= Math.min(currentPage * limit, totalCount).toLocaleString() %>
              of <%= totalCount.toLocaleString() %> <%= totalCount === 1 ? 'thesis' : 'theses' %>
            </div>
          </div>

          <!-- Theses List -->
          <div class="space-y-4">
            <% theses.forEach(thesis => { %>
              <article class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
                <!-- Title -->
                <h3 class="text-xl font-bold text-gray-900 mb-2">
                  <a href="/thesis/<%= thesis.id %>" class="hover:text-blue-600 transition-colors">
                    <%= thesis.title %>
                  </a>
                </h3>

                <!-- Metadata -->
                <div class="flex flex-wrap items-center gap-3 text-sm text-gray-600 mb-3">
                  <span>
                    <i class="fas fa-user mr-1"></i><%= thesis.submitter.name %>
                  </span>
                  <span>•</span>
                  <span>
                    <i class="fas fa-calendar mr-1"></i><%= thesis.graduationYear %>
                  </span>
                  <% if (thesis.advisor) { %>
                    <span>•</span>
                    <span>
                      <i class="fas fa-chalkboard-teacher mr-1"></i><%= thesis.advisor %>
                    </span>
                  <% } %>
                </div>

                <!-- Abstract Snippet -->
                <% if (thesis.abstractId) { %>
                  <p class="text-gray-700 mb-3 line-clamp-3">
                    <%= thesis.abstractId.substring(0, 200) %><%= thesis.abstractId.length > 200 ? '...' : '' %>
                  </p>
                <% } %>

                <!-- Keywords -->
                <% if (thesis.keywords) { %>
                  <div class="flex flex-wrap gap-2 mb-3">
                    <% thesis.keywords.split(',').slice(0, 5).forEach(keyword => { %>
                      <span class="px-3 py-1 bg-gray-100 text-gray-700 text-xs rounded-full">
                        <%= keyword.trim() %>
                      </span>
                    <% }); %>
                  </div>
                <% } %>

                <!-- Stats -->
                <div class="flex items-center gap-4 text-sm text-gray-500">
                  <span>
                    <i class="fas fa-eye mr-1"></i><%= thesis.viewCount || 0 %> views
                  </span>
                  <span>
                    <i class="fas fa-download mr-1"></i><%= thesis.downloadCount || 0 %> downloads
                  </span>
                  <% if (thesis._count.files > 0) { %>
                    <span>
                      <i class="fas fa-file mr-1"></i><%= thesis._count.files %> file(s)
                    </span>
                  <% } %>
                </div>
              </article>
            <% }); %>
          </div>

          <!-- Pagination -->
          <% if (totalPages > 1) { %>
            <div class="mt-8 flex justify-center">
              <nav class="flex items-center gap-2">
                <!-- Previous Button -->
                <% if (hasPrevPage) { %>
                  <a
                    href="/browse/departments/<%= department.id %>?page=<%= currentPage - 1 %><%= filters.graduationYear ? '&year=' + filters.graduationYear : '' %>&sort=<%= filters.sort %>"
                    class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 text-gray-700"
                  >
                    <i class="fas fa-chevron-left mr-1"></i>Previous
                  </a>
                <% } else { %>
                  <span class="px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-400 cursor-not-allowed">
                    <i class="fas fa-chevron-left mr-1"></i>Previous
                  </span>
                <% } %>

                <!-- Page Numbers -->
                <div class="hidden sm:flex gap-2">
                  <%
                    const maxPages = 5;
                    let startPage = Math.max(1, currentPage - Math.floor(maxPages / 2));
                    let endPage = Math.min(totalPages, startPage + maxPages - 1);

                    if (endPage - startPage < maxPages - 1) {
                      startPage = Math.max(1, endPage - maxPages + 1);
                    }
                  %>

                  <% if (startPage > 1) { %>
                    <a
                      href="/browse/departments/<%= department.id %>?page=1<%= filters.graduationYear ? '&year=' + filters.graduationYear : '' %>&sort=<%= filters.sort %>"
                      class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 text-gray-700"
                    >
                      1
                    </a>
                    <% if (startPage > 2) { %>
                      <span class="px-4 py-2 text-gray-500">...</span>
                    <% } %>
                  <% } %>

                  <% for (let i = startPage; i <= endPage; i++) { %>
                    <% if (i === currentPage) { %>
                      <span class="px-4 py-2 bg-blue-600 text-white rounded-lg font-semibold">
                        <%= i %>
                      </span>
                    <% } else { %>
                      <a
                        href="/browse/departments/<%= department.id %>?page=<%= i %><%= filters.graduationYear ? '&year=' + filters.graduationYear : '' %>&sort=<%= filters.sort %>"
                        class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 text-gray-700"
                      >
                        <%= i %>
                      </a>
                    <% } %>
                  <% } %>

                  <% if (endPage < totalPages) { %>
                    <% if (endPage < totalPages - 1) { %>
                      <span class="px-4 py-2 text-gray-500">...</span>
                    <% } %>
                    <a
                      href="/browse/departments/<%= department.id %>?page=<%= totalPages %><%= filters.graduationYear ? '&year=' + filters.graduationYear : '' %>&sort=<%= filters.sort %>"
                      class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 text-gray-700"
                    >
                      <%= totalPages %>
                    </a>
                  <% } %>
                </div>

                <!-- Next Button -->
                <% if (hasNextPage) { %>
                  <a
                    href="/browse/departments/<%= department.id %>?page=<%= currentPage + 1 %><%= filters.graduationYear ? '&year=' + filters.graduationYear : '' %>&sort=<%= filters.sort %>"
                    class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 text-gray-700"
                  >
                    Next<i class="fas fa-chevron-right ml-1"></i>
                  </a>
                <% } else { %>
                  <span class="px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-400 cursor-not-allowed">
                    Next<i class="fas fa-chevron-right ml-1"></i>
                  </span>
                <% } %>
              </nav>
            </div>
          <% } %>

        <% } else { %>
          <!-- Empty State -->
          <div class="bg-white rounded-lg shadow-md p-12 text-center">
            <div class="mb-6">
              <i class="fas fa-book text-6xl text-gray-300"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">No Theses Found</h3>
            <p class="text-gray-600 mb-8">
              <% if (filters.graduationYear) { %>
                No theses found for the selected year. Try a different year or clear filters.
              <% } else { %>
                This department does not have any approved theses yet.
              <% } %>
            </p>
            <div class="flex gap-4 justify-center">
              <% if (filters.graduationYear || filters.sort !== 'year') { %>
                <a
                  href="/browse/departments/<%= department.id %>"
                  class="inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-colors"
                >
                  <i class="fas fa-times mr-2"></i>Clear Filters
                </a>
              <% } %>
              <a
                href="/browse/faculties/<%= faculty.id %>"
                class="inline-block px-6 py-3 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-semibold transition-colors"
              >
                <i class="fas fa-arrow-left mr-2"></i>Back to <%= faculty.name %>
              </a>
            </div>
          </div>
        <% } %>
      </main>
    </div>
  </div>
</div>
