<!-- Faculty Detail Page -->
<div class="min-h-screen bg-gray-50">
  <!-- Page Header -->
  <div class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-12">
    <div class="container mx-auto px-4">
      <!-- Breadcrumb -->
      <div class="text-sm mb-4">
        <a href="/" class="hover:text-blue-200 transition">
          <i class="fas fa-home mr-1"></i>Home
        </a>
        <span class="mx-2">/</span>
        <a href="/browse/faculties" class="hover:text-blue-200 transition">
          Browse by Faculty
        </a>
        <span class="mx-2">/</span>
        <span><%= faculty.name %></span>
      </div>

      <div class="flex items-start justify-between">
        <div class="flex-1">
          <h1 class="text-4xl font-bold mb-4"><%= faculty.name %></h1>
          <% if (faculty.code) { %>
            <p class="text-blue-100 text-lg mb-4">Code: <%= faculty.code %></p>
          <% } %>
          <% if (faculty.description) { %>
            <p class="text-blue-100 max-w-3xl"><%= faculty.description %></p>
          <% } %>
        </div>
        <div class="hidden lg:block ml-8">
          <i class="fas fa-university text-8xl text-blue-300 opacity-50"></i>
        </div>
      </div>

      <!-- Statistics Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8 max-w-2xl">
        <div class="bg-white bg-opacity-20 backdrop-blur-sm rounded-lg p-4">
          <div class="text-3xl font-bold mb-1">
            <%= faculty.totalTheses.toLocaleString() %>
          </div>
          <div class="text-blue-100">Total Theses</div>
        </div>
        <div class="bg-white bg-opacity-20 backdrop-blur-sm rounded-lg p-4">
          <div class="text-3xl font-bold mb-1">
            <%= faculty.departmentCount %>
          </div>
          <div class="text-blue-100">Departments</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">
      Browse by Department
    </h2>

    <% if (departments.length > 0) { %>
      <!-- Department List -->
      <div class="space-y-4">
        <% departments.forEach(department => { %>
          <a
            href="/browse/departments/<%= department.id %>"
            class="block bg-white rounded-lg shadow-md hover:shadow-lg transition-all p-6 group"
          >
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                    <i class="fas fa-building text-blue-600 text-xl"></i>
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
                      <%= department.name %>
                    </h3>
                    <% if (department.code) { %>
                      <p class="text-sm text-gray-500">Code: <%= department.code %></p>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-6">
                <!-- Thesis Count Badge -->
                <div class="text-center">
                  <div class="text-3xl font-bold text-blue-600">
                    <%= department.thesisCount.toLocaleString() %>
                  </div>
                  <div class="text-xs text-gray-500 mt-1">
                    <%= department.thesisCount === 1 ? 'Thesis' : 'Theses' %>
                  </div>
                </div>

                <!-- Arrow Icon -->
                <div class="text-gray-400 group-hover:text-blue-600 transition-colors">
                  <i class="fas fa-chevron-right text-2xl"></i>
                </div>
              </div>
            </div>
          </a>
        <% }); %>
      </div>

      <!-- Summary -->
      <div class="mt-8 text-center text-gray-600">
        <p>
          Showing <span class="font-bold text-gray-900"><%= departments.length %></span>
          <%= departments.length === 1 ? 'department' : 'departments' %>
          with <span class="font-bold text-gray-900"><%= faculty.totalTheses.toLocaleString() %></span>
          total <%= faculty.totalTheses === 1 ? 'thesis' : 'theses' %>
        </p>
      </div>

    <% } else { %>
      <!-- Empty State -->
      <div class="bg-white rounded-lg shadow-md p-12 text-center">
        <div class="mb-6">
          <i class="fas fa-building text-6xl text-gray-300"></i>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">No Departments Found</h3>
        <p class="text-gray-600 mb-8">
          This faculty does not have any departments with approved theses yet.
        </p>
        <a
          href="/browse/faculties"
          class="inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-colors"
        >
          <i class="fas fa-arrow-left mr-2"></i>Back to Faculties
        </a>
      </div>
    <% } %>
  </div>
</div>
