<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Admin Panel - Thesis Repository</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Alpine.js CDN -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Custom Tailwind Config -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            admin: {
              50: '#f8fafc',
              100: '#f1f5f9',
              200: '#e2e8f0',
              300: '#cbd5e1',
              400: '#94a3b8',
              500: '#64748b',
              600: '#475569',
              700: '#334155',
              800: '#1e293b',
              900: '#0f172a',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-gray-100" x-data="{ sidebarOpen: true, mobileSidebarOpen: false }">

  <!-- Sidebar -->
  <aside class="fixed inset-y-0 left-0 z-50 w-64 bg-admin-900 text-white transform transition-transform duration-300 lg:translate-x-0"
         :class="{ '-translate-x-full': !mobileSidebarOpen }"
         x-show="sidebarOpen || mobileSidebarOpen">

    <!-- Sidebar Header -->
    <div class="flex items-center justify-between h-16 px-6 bg-admin-800 border-b border-admin-700">
      <div class="flex items-center space-x-3">
        <i class="fas fa-user-shield text-blue-400 text-2xl"></i>
        <span class="text-lg font-bold">Admin Panel</span>
      </div>
      <button @click="mobileSidebarOpen = false" class="lg:hidden text-gray-400 hover:text-white">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <!-- User Info -->
    <div class="px-6 py-4 bg-admin-800 border-b border-admin-700">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center">
          <i class="fas fa-user text-white"></i>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-sm"><%= user.name %></p>
          <p class="text-xs text-gray-400"><%= user.email || 'Administrator' %></p>
        </div>
      </div>
    </div>

    <!-- Navigation Menu -->
    <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto" style="max-height: calc(100vh - 180px);">

      <!-- Dashboard -->
      <a href="/admin/dashboard" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-300 hover:bg-admin-800 hover:text-white transition group">
        <i class="fas fa-tachometer-alt text-blue-400 group-hover:text-blue-300"></i>
        <span>Dashboard</span>
      </a>

      <!-- Faculties & Departments -->
      <div x-data="{ open: false }">
        <button @click="open = !open" class="w-full flex items-center justify-between px-4 py-3 rounded-lg text-gray-300 hover:bg-admin-800 hover:text-white transition">
          <div class="flex items-center space-x-3">
            <i class="fas fa-building text-purple-400"></i>
            <span>Organizations</span>
          </div>
          <i class="fas fa-chevron-down text-xs transition-transform" :class="{ 'rotate-180': open }"></i>
        </button>
        <div x-show="open" x-collapse class="pl-11 mt-2 space-y-1">
          <a href="/admin/faculties" class="block px-4 py-2 rounded text-sm text-gray-400 hover:text-white hover:bg-admin-800">
            Faculties
          </a>
          <a href="/admin/departments" class="block px-4 py-2 rounded text-sm text-gray-400 hover:text-white hover:bg-admin-800">
            Departments
          </a>
        </div>
      </div>

      <!-- Lecturers -->
      <a href="/admin/lecturers" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-300 hover:bg-admin-800 hover:text-white transition group">
        <i class="fas fa-chalkboard-teacher text-green-400 group-hover:text-green-300"></i>
        <span>Lecturers</span>
      </a>

      <!-- Users -->
      <a href="/admin/users" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-300 hover:bg-admin-800 hover:text-white transition group">
        <i class="fas fa-users text-yellow-400 group-hover:text-yellow-300"></i>
        <span>Users</span>
      </a>

      <!-- Theses -->
      <div x-data="{ open: false }">
        <button @click="open = !open" class="w-full flex items-center justify-between px-4 py-3 rounded-lg text-gray-300 hover:bg-admin-800 hover:text-white transition">
          <div class="flex items-center space-x-3">
            <i class="fas fa-file-alt text-red-400"></i>
            <span>Theses</span>
          </div>
          <i class="fas fa-chevron-down text-xs transition-transform" :class="{ 'rotate-180': open }"></i>
        </button>
        <div x-show="open" x-collapse class="pl-11 mt-2 space-y-1">
          <a href="/admin/theses" class="block px-4 py-2 rounded text-sm text-gray-400 hover:text-white hover:bg-admin-800">
            All Theses
          </a>
          <a href="/admin/theses/pending" class="block px-4 py-2 rounded text-sm text-gray-400 hover:text-white hover:bg-admin-800">
            Pending Review
            <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
              <span class="ml-2 px-2 py-1 text-xs bg-red-500 text-white rounded-full"><%= pendingCount %></span>
            <% } %>
          </a>
          <a href="/admin/theses/approved" class="block px-4 py-2 rounded text-sm text-gray-400 hover:text-white hover:bg-admin-800">
            Approved
          </a>
          <a href="/admin/theses/rejected" class="block px-4 py-2 rounded text-sm text-gray-400 hover:text-white hover:bg-admin-800">
            Rejected
          </a>
        </div>
      </div>

      <!-- Statistics -->
      <a href="/admin/statistics" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-300 hover:bg-admin-800 hover:text-white transition group">
        <i class="fas fa-chart-bar text-indigo-400 group-hover:text-indigo-300"></i>
        <span>Statistics</span>
      </a>

      <!-- Settings -->
      <a href="/admin/settings" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-300 hover:bg-admin-800 hover:text-white transition group">
        <i class="fas fa-cog text-gray-400 group-hover:text-gray-300"></i>
        <span>Settings</span>
      </a>

      <hr class="my-4 border-admin-700">

      <!-- Logout -->
      <a href="/auth/logout" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-red-400 hover:bg-red-900/20 hover:text-red-300 transition group">
        <i class="fas fa-sign-out-alt"></i>
        <span>Logout</span>
      </a>
    </nav>

  </aside>

  <!-- Main Content Area -->
  <div class="lg:ml-64 min-h-screen">

    <!-- Top Bar -->
    <header class="bg-white shadow-sm sticky top-0 z-40">
      <div class="flex items-center justify-between h-16 px-6">

        <!-- Mobile Menu Toggle & Page Title -->
        <div class="flex items-center space-x-4">
          <button @click="mobileSidebarOpen = !mobileSidebarOpen" class="lg:hidden text-gray-600 hover:text-gray-900">
            <i class="fas fa-bars text-xl"></i>
          </button>

          <button @click="sidebarOpen = !sidebarOpen" class="hidden lg:block text-gray-600 hover:text-gray-900">
            <i class="fas" :class="sidebarOpen ? 'fa-bars' : 'fa-bars'"></i>
          </button>

          <h1 class="text-xl font-semibold text-gray-900">
            <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %>
          </h1>
        </div>

        <!-- Top Bar Actions -->
        <div class="flex items-center space-x-4">

          <!-- Notifications -->
          <div x-data="{ open: false }" class="relative">
            <button @click="open = !open" class="relative text-gray-600 hover:text-gray-900">
              <i class="fas fa-bell text-xl"></i>
              <% if (typeof notificationCount !== 'undefined' && notificationCount > 0) { %>
                <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center">
                  <%= notificationCount %>
                </span>
              <% } %>
            </button>

            <!-- Notifications Dropdown -->
            <div x-show="open" @click.away="open = false"
                 x-transition
                 class="absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-xl border border-gray-200 py-2 z-50">
              <div class="px-4 py-2 border-b border-gray-200">
                <h3 class="font-semibold text-gray-900">Notifications</h3>
              </div>
              <div class="max-h-96 overflow-y-auto">
                <p class="px-4 py-8 text-center text-gray-500 text-sm">No new notifications</p>
              </div>
            </div>
          </div>

          <!-- User Menu -->
          <div x-data="{ open: false }" class="relative">
            <button @click="open = !open" class="flex items-center space-x-3 text-gray-700 hover:text-gray-900">
              <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center">
                <i class="fas fa-user text-white text-sm"></i>
              </div>
              <span class="hidden md:block font-medium"><%= user.name %></span>
              <i class="fas fa-chevron-down text-xs"></i>
            </button>

            <!-- User Dropdown -->
            <div x-show="open" @click.away="open = false"
                 x-transition
                 class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-xl border border-gray-200 py-2 z-50">
              <a href="/admin/profile" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">
                <i class="fas fa-user mr-2"></i>Profile
              </a>
              <a href="/admin/settings" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">
                <i class="fas fa-cog mr-2"></i>Settings
              </a>
              <hr class="my-2">
              <a href="/auth/logout" class="block px-4 py-2 text-red-600 hover:bg-red-50">
                <i class="fas fa-sign-out-alt mr-2"></i>Logout
              </a>
            </div>
          </div>
        </div>

      </div>
    </header>

    <!-- Flash Messages -->
    <%- include('../partials/flash') %>

    <!-- Page Content -->
    <main class="p-6">
      <%- body %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 py-4 px-6 mt-8">
      <div class="text-center text-sm text-gray-600">
        &copy; <%= new Date().getFullYear() %> Thesis Repository System. Admin Panel.
      </div>
    </footer>

  </div>

  <!-- Mobile Sidebar Overlay -->
  <div x-show="mobileSidebarOpen"
       @click="mobileSidebarOpen = false"
       x-transition:enter="transition-opacity ease-linear duration-300"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition-opacity ease-linear duration-300"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"
       class="fixed inset-0 bg-black bg-opacity-50 z-40 lg:hidden"></div>

</body>
</html>
