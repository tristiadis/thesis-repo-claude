<!-- Thesis Submission Form -->
<div x-data="submissionForm()" x-init="init()" class="space-y-6">

  <!-- Progress Indicator -->
  <div class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Submission Progress</h2>
      <span class="text-sm text-gray-500" x-text="completionPercentage + '% Complete'"></span>
    </div>
    <div class="w-full bg-gray-200 rounded-full h-3">
      <div class="bg-blue-600 h-3 rounded-full transition-all duration-500" :style="`width: ${completionPercentage}%`"></div>
    </div>
  </div>

  <!-- Validation Checklist -->
  <div class="bg-white rounded-xl shadow-sm p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">
      <i data-lucide="check-circle" class="w-5 h-5 inline mr-2"></i>
      Requirements Checklist
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <!-- Basic Info Checks -->
      <div class="flex items-center space-x-2">
        <i data-lucide="<%= validation.checks.hasTitle ? 'check-circle' : 'x-circle' %>"
           class="w-5 h-5 <%= validation.checks.hasTitle ? 'text-green-500' : 'text-red-500' %>"></i>
        <span class="text-sm <%= validation.checks.hasTitle ? 'text-gray-700' : 'text-red-600' %>">
          Title provided
        </span>
      </div>

      <div class="flex items-center space-x-2">
        <i data-lucide="<%= validation.checks.hasAuthor ? 'check-circle' : 'x-circle' %>"
           class="w-5 h-5 <%= validation.checks.hasAuthor ? 'text-green-500' : 'text-red-500' %>"></i>
        <span class="text-sm <%= validation.checks.hasAuthor ? 'text-gray-700' : 'text-red-600' %>">
          Author information complete
        </span>
      </div>

      <div class="flex items-center space-x-2">
        <i data-lucide="<%= validation.checks.hasDepartment ? 'check-circle' : 'x-circle' %>"
           class="w-5 h-5 <%= validation.checks.hasDepartment ? 'text-green-500' : 'text-red-500' %>"></i>
        <span class="text-sm <%= validation.checks.hasDepartment ? 'text-gray-700' : 'text-red-600' %>">
          Department selected
        </span>
      </div>

      <div class="flex items-center space-x-2">
        <i data-lucide="<%= validation.checks.hasGraduationYear ? 'check-circle' : 'x-circle' %>"
           class="w-5 h-5 <%= validation.checks.hasGraduationYear ? 'text-green-500' : 'text-red-500' %>"></i>
        <span class="text-sm <%= validation.checks.hasGraduationYear ? 'text-gray-700' : 'text-red-600' %>">
          Graduation year provided
        </span>
      </div>

      <div class="flex items-center space-x-2">
        <i data-lucide="<%= validation.checks.hasAbstract ? 'check-circle' : 'x-circle' %>"
           class="w-5 h-5 <%= validation.checks.hasAbstract ? 'text-green-500' : 'text-red-500' %>"></i>
        <span class="text-sm <%= validation.checks.hasAbstract ? 'text-gray-700' : 'text-red-600' %>">
          Abstract provided
        </span>
      </div>

      <div class="flex items-center space-x-2">
        <i data-lucide="<%= validation.checks.hasKeywords ? 'check-circle' : 'x-circle' %>"
           class="w-5 h-5 <%= validation.checks.hasKeywords ? 'text-green-500' : 'text-red-500' %>"></i>
        <span class="text-sm <%= validation.checks.hasKeywords ? 'text-gray-700' : 'text-red-600' %>">
          Keywords provided
        </span>
      </div>

      <div class="flex items-center space-x-2">
        <i data-lucide="<%= validation.checks.hasAdvisor1 ? 'check-circle' : 'x-circle' %>"
           class="w-5 h-5 <%= validation.checks.hasAdvisor1 ? 'text-green-500' : 'text-red-500' %>"></i>
        <span class="text-sm <%= validation.checks.hasAdvisor1 ? 'text-gray-700' : 'text-red-600' %>">
          Main advisor selected
        </span>
      </div>

      <div class="flex items-center space-x-2">
        <i data-lucide="<%= validation.checks.hasRequiredFiles ? 'check-circle' : 'x-circle' %>"
           class="w-5 h-5 <%= validation.checks.hasRequiredFiles ? 'text-green-500' : 'text-red-500' %>"></i>
        <span class="text-sm <%= validation.checks.hasRequiredFiles ? 'text-gray-700' : 'text-red-600' %>">
          All required files uploaded
        </span>
      </div>
    </div>

    <% if (!validation.isValid) { %>
    <div class="mt-4 p-3 bg-red-50 border-l-4 border-red-500 rounded">
      <p class="text-sm text-red-800 font-medium">Please complete all required fields before submitting.</p>
    </div>
    <% } %>
  </div>

  <!-- Submission Form -->
  <form id="submissionForm" @submit.prevent="handleSubmit" class="space-y-6">

    <!-- Section 1: Basic Information -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-gray-900">
          <i data-lucide="file-text" class="w-5 h-5 inline mr-2"></i>
          Basic Information
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Title (Indonesian) -->
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Title (Indonesian) <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            name="title"
            x-model="formData.title"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Enter thesis title in Indonesian"
          />
        </div>

        <!-- Title (English) -->
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Title (English)
          </label>
          <input
            type="text"
            name="titleEn"
            x-model="formData.titleEn"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Enter thesis title in English (optional)"
          />
        </div>

        <!-- Author Name -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Author Name <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            name="authorName"
            x-model="formData.authorName"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Full name"
          />
        </div>

        <!-- Student ID -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Student ID (NIM) <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            name="studentId"
            x-model="formData.studentId"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="e.g., 1234567890"
          />
        </div>

        <!-- Department -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Department <span class="text-red-500">*</span>
          </label>
          <select
            name="departmentId"
            x-model="formData.departmentId"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option value="">Select department</option>
            <% departments.forEach(dept => { %>
              <option value="<%= dept.id %>"><%= dept.name %> - <%= dept.faculty.name %></option>
            <% }); %>
          </select>
        </div>

        <!-- Graduation Year -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Graduation Year <span class="text-red-500">*</span>
          </label>
          <input
            type="number"
            name="graduationYear"
            x-model="formData.graduationYear"
            required
            min="2000"
            max="2100"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="e.g., 2024"
          />
        </div>

        <!-- Defense Date -->
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Defense Date (Tanggal Sidang)
          </label>
          <input
            type="date"
            name="defenseDate"
            x-model="formData.defenseDate"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
        </div>
      </div>
    </div>

    <!-- Section 2: Abstract & Keywords -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-gray-900">
          <i data-lucide="align-left" class="w-5 h-5 inline mr-2"></i>
          Abstract & Keywords
        </h2>
      </div>

      <div class="space-y-6">
        <!-- Abstract (Indonesian) -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Abstract (Indonesian) <span class="text-red-500">*</span>
          </label>
          <textarea
            name="abstractId"
            x-model="formData.abstractId"
            required
            rows="6"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Enter abstract in Indonesian (max 500 words)"
          ></textarea>
        </div>

        <!-- Abstract (English) -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Abstract (English)
          </label>
          <textarea
            name="abstractEn"
            x-model="formData.abstractEn"
            rows="6"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Enter abstract in English (optional)"
          ></textarea>
        </div>

        <!-- Keywords (Indonesian) -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Keywords (Indonesian) <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            name="keywords"
            x-model="formData.keywords"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Separate keywords with commas (e.g., machine learning, data mining)"
          />
          <p class="text-xs text-gray-500 mt-1">Use commas to separate keywords</p>
        </div>

        <!-- Keywords (English) -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Keywords (English)
          </label>
          <input
            type="text"
            name="keywordsEn"
            x-model="formData.keywordsEn"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Separate keywords with commas (optional)"
          />
        </div>
      </div>
    </div>

    <!-- Section 3: Advisors & Examiners -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-gray-900">
          <i data-lucide="users" class="w-5 h-5 inline mr-2"></i>
          Advisors & Examiners
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Advisor 1 -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Main Advisor (Pembimbing Utama) <span class="text-red-500">*</span>
          </label>
          <select
            name="advisor1Id"
            x-model="formData.advisor1Id"
            @change="checkDuplicates"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option value="">Select advisor</option>
            <% lecturers.forEach(lecturer => { %>
              <option value="<%= lecturer.id %>"><%= lecturer.name %> - <%= lecturer.department.name %></option>
            <% }); %>
          </select>
        </div>

        <!-- Advisor 2 -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Co-Advisor (Pembimbing Pendamping)
          </label>
          <select
            name="advisor2Id"
            x-model="formData.advisor2Id"
            @change="checkDuplicates"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option value="">None</option>
            <% lecturers.forEach(lecturer => { %>
              <option value="<%= lecturer.id %>"><%= lecturer.name %> - <%= lecturer.department.name %></option>
            <% }); %>
          </select>
        </div>

        <!-- Examiner 1 -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Examiner 1 (Penguji 1) <span class="text-red-500">*</span>
          </label>
          <select
            name="examiner1Id"
            x-model="formData.examiner1Id"
            @change="checkDuplicates"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option value="">Select examiner</option>
            <% lecturers.forEach(lecturer => { %>
              <option value="<%= lecturer.id %>"><%= lecturer.name %> - <%= lecturer.department.name %></option>
            <% }); %>
          </select>
        </div>

        <!-- Examiner 2 -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Examiner 2 (Penguji 2)
          </label>
          <select
            name="examiner2Id"
            x-model="formData.examiner2Id"
            @change="checkDuplicates"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option value="">None</option>
            <% lecturers.forEach(lecturer => { %>
              <option value="<%= lecturer.id %>"><%= lecturer.name %> - <%= lecturer.department.name %></option>
            <% }); %>
          </select>
        </div>

        <!-- Examiner 3 -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Examiner 3 (Penguji 3)
          </label>
          <select
            name="examiner3Id"
            x-model="formData.examiner3Id"
            @change="checkDuplicates"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option value="">None</option>
            <% lecturers.forEach(lecturer => { %>
              <option value="<%= lecturer.id %>"><%= lecturer.name %> - <%= lecturer.department.name %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <!-- Duplicate Warning -->
      <div x-show="hasDuplicates" class="mt-4 p-3 bg-red-50 border-l-4 border-red-500 rounded">
        <p class="text-sm text-red-800 font-medium">
          <i data-lucide="alert-triangle" class="w-4 h-4 inline mr-1"></i>
          Error: Same lecturer cannot be selected multiple times
        </p>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap gap-4 justify-end">
      <button
        type="button"
        @click="saveDraft"
        class="px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition font-medium"
      >
        <i data-lucide="save" class="w-4 h-4 inline mr-2"></i>
        Save as Draft
      </button>

      <button
        type="button"
        @click="confirmSubmit"
        :disabled="!canSubmit"
        :class="canSubmit ? 'bg-blue-600 hover:bg-blue-700' : 'bg-gray-300 cursor-not-allowed'"
        class="px-6 py-3 text-white rounded-lg transition font-medium"
      >
        <i data-lucide="send" class="w-4 h-4 inline mr-2"></i>
        Submit for Review
      </button>
    </div>
  </form>

  <!-- Confirmation Modal -->
  <div x-show="showConfirmModal" x-cloak class="fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen px-4">
      <!-- Overlay -->
      <div @click="showConfirmModal = false" class="fixed inset-0 bg-black bg-opacity-50 transition-opacity"></div>

      <!-- Modal Content -->
      <div class="relative bg-white rounded-xl shadow-2xl max-w-md w-full p-6">
        <div class="text-center">
          <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-yellow-100 mb-4">
            <i data-lucide="alert-triangle" class="w-8 h-8 text-yellow-600"></i>
          </div>

          <h3 class="text-lg font-semibold text-gray-900 mb-2">Confirm Submission</h3>
          <p class="text-sm text-gray-600 mb-6">
            Are you sure you want to submit your thesis for review? You won't be able to edit it after submission.
          </p>

          <div class="flex space-x-3">
            <button
              @click="showConfirmModal = false"
              class="flex-1 px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition font-medium"
            >
              Cancel
            </button>
            <button
              @click="submitForReview"
              class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium"
            >
              Yes, Submit
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- Alpine.js Form Logic -->
<script>
function submissionForm() {
  return {
    formData: {
      title: '<%= submissionData.title || "" %>',
      titleEn: '<%= submissionData.titleEn || "" %>',
      authorName: '<%= submissionData.authorName || "" %>',
      studentId: '<%= submissionData.studentId || "" %>',
      departmentId: '<%= submissionData.departmentId || "" %>',
      graduationYear: '<%= submissionData.graduationYear || "" %>',
      defenseDate: '<%= submissionData.defenseDate || "" %>',
      abstractId: '<%= submissionData.abstractId || "" %>',
      abstractEn: '<%= submissionData.abstractEn || "" %>',
      keywords: '<%= submissionData.keywords || "" %>',
      keywordsEn: '<%= submissionData.keywordsEn || "" %>',
      advisor1Id: '<%= submissionData.advisor1Id || "" %>',
      advisor2Id: '<%= submissionData.advisor2Id || "" %>',
      examiner1Id: '<%= submissionData.examiner1Id || "" %>',
      examiner2Id: '<%= submissionData.examiner2Id || "" %>',
      examiner3Id: '<%= submissionData.examiner3Id || "" %>',
    },
    hasDuplicates: false,
    showConfirmModal: false,

    init() {
      // Initialize Lucide icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
      this.checkDuplicates();
    },

    get completionPercentage() {
      const validation = <%= JSON.stringify(validation.checks) %>;
      const totalChecks = Object.keys(validation).length;
      const completedChecks = Object.values(validation).filter(v => v === true).length;
      return Math.round((completedChecks / totalChecks) * 100);
    },

    get canSubmit() {
      const validation = <%= JSON.stringify(validation) %>;
      return validation.isValid && !this.hasDuplicates;
    },

    checkDuplicates() {
      const selectedIds = [
        this.formData.advisor1Id,
        this.formData.advisor2Id,
        this.formData.examiner1Id,
        this.formData.examiner2Id,
        this.formData.examiner3Id,
      ].filter(id => id !== '' && id !== null);

      const uniqueIds = new Set(selectedIds);
      this.hasDuplicates = selectedIds.length !== uniqueIds.size;
    },

    saveDraft() {
      const form = document.getElementById('submissionForm');
      form.action = '/student/submit/draft';
      form.submit();
    },

    confirmSubmit() {
      if (!this.canSubmit) {
        alert('Please complete all required fields before submitting.');
        return;
      }
      this.showConfirmModal = true;
    },

    submitForReview() {
      const form = document.getElementById('submissionForm');
      form.action = '/student/submit';
      form.submit();
    },

    handleSubmit(e) {
      e.preventDefault();
      // Default form submission is prevented, use buttons instead
    }
  }
}
</script>

<!-- Initialize Lucide Icons -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
