<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('errors.403.title') %> - <%= __('home.title') %></title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center px-4">

  <div class="text-center max-w-2xl mx-auto">
    <!-- Error Icon -->
    <div class="mb-8">
      <i class="fas fa-lock text-red-500 text-8xl opacity-20"></i>
    </div>

    <!-- Error Code -->
    <h1 class="text-9xl font-bold text-gray-900 mb-4">403</h1>

    <!-- Error Title -->
    <h2 class="text-3xl font-bold text-gray-900 mb-4">
      <%= __('errors.403.title') %>
    </h2>

    <!-- Error Message -->
    <p class="text-gray-600 text-lg mb-4">
      <%= message || __('errors.403.message') %>
    </p>

    <% if (typeof details !== 'undefined' && details) { %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-8">
        <p class="text-yellow-800 text-sm"><%= details %></p>
      </div>
    <% } %>

    <!-- Information Box -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8 text-left">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">
        <%= __('common.and').charAt(0).toUpperCase() + __('common.and').slice(1) %> <%= __('common.or').toLowerCase() %>:
      </h3>
      <ul class="space-y-2 text-gray-600">
        <li class="flex items-start">
          <i class="fas fa-check-circle text-green-500 mt-1 mr-3"></i>
          <span><%= __('auth.login') %> <%= __('common.or').toLowerCase() %> <%= __('auth.register').toLowerCase() %></span>
        </li>
        <li class="flex items-start">
          <i class="fas fa-check-circle text-green-500 mt-1 mr-3"></i>
          <span><%= __('footer.contact') %> administrator <%= __('common.or').toLowerCase() %> <%= __('footer.help') %></span>
        </li>
        <li class="flex items-start">
          <i class="fas fa-check-circle text-green-500 mt-1 mr-3"></i>
          <span><%= __('common.back') %> <%= __('nav.home').toLowerCase() %> <%= __('common.and').toLowerCase() %> <%= __('nav.browse').toLowerCase() %></span>
        </li>
      </ul>
    </div>

    <!-- Action Buttons -->
    <div class="flex gap-4 justify-center flex-wrap">
      <button
        onclick="window.history.back()"
        class="px-6 py-3 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-semibold transition tap-target"
      >
        <i class="fas fa-arrow-left mr-2"></i><%= __('common.back') %>
      </button>

      <% if (!user) { %>
        <a
          href="/auth/login"
          class="px-6 py-3 bg-primary hover:bg-blue-700 text-white rounded-lg font-semibold transition tap-target"
        >
          <i class="fas fa-sign-in-alt mr-2"></i><%= __('nav.login') %>
        </a>
      <% } %>

      <a
        href="/"
        class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-lg font-semibold transition tap-target"
      >
        <i class="fas fa-home mr-2"></i><%= __('nav.home') %>
      </a>
    </div>

    <!-- Support Link -->
    <div class="mt-8 text-gray-500">
      <p class="text-sm">
        <%= __('thesis.report_issue') %>? <a href="/contact" class="text-primary hover:underline"><%= __('footer.contact') %></a>
      </p>
    </div>
  </div>

  <style>
    .tap-target {
      min-height: 44px;
      min-width: 44px;
    }
  </style>

</body>
</html>
