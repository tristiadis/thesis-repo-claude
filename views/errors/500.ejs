<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('errors.500.title') %> - <%= __('home.title') %></title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center px-4">

  <div class="text-center max-w-3xl mx-auto">
    <!-- Error Icon -->
    <div class="mb-8">
      <i class="fas fa-exclamation-triangle text-orange-500 text-8xl opacity-20"></i>
    </div>

    <!-- Error Code -->
    <h1 class="text-9xl font-bold text-gray-900 mb-4">500</h1>

    <!-- Error Title -->
    <h2 class="text-3xl font-bold text-gray-900 mb-4">
      <%= __('errors.500.title') %>
    </h2>

    <!-- Error Message -->
    <p class="text-gray-600 text-lg mb-8">
      <%= message || __('errors.500.message') %>
    </p>

    <!-- Development Error Details -->
    <% if (typeof details !== 'undefined' && details) { %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-6 mb-8 text-left">
        <h3 class="text-red-800 font-semibold mb-2 flex items-center">
          <i class="fas fa-bug mr-2"></i>
          Development Error Details:
        </h3>
        <pre class="text-xs text-red-700 overflow-x-auto whitespace-pre-wrap bg-red-100 p-4 rounded"><%= details %></pre>
        <p class="text-xs text-red-600 mt-2">
          <i class="fas fa-info-circle mr-1"></i>
          This detailed error information is only visible in development mode.
        </p>
      </div>
    <% } %>

    <!-- Information Box -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">
        What you can do:
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
        <div class="flex items-start">
          <i class="fas fa-redo text-primary mt-1 mr-3"></i>
          <div>
            <div class="font-semibold text-gray-900">Try Again</div>
            <div class="text-sm text-gray-600">The issue might be temporary</div>
          </div>
        </div>
        <div class="flex items-start">
          <i class="fas fa-home text-primary mt-1 mr-3"></i>
          <div>
            <div class="font-semibold text-gray-900">Go Home</div>
            <div class="text-sm text-gray-600">Start from the homepage</div>
          </div>
        </div>
        <div class="flex items-start">
          <i class="fas fa-envelope text-primary mt-1 mr-3"></i>
          <div>
            <div class="font-semibold text-gray-900">Contact Support</div>
            <div class="text-sm text-gray-600">Report this issue to us</div>
          </div>
        </div>
        <div class="flex items-start">
          <i class="fas fa-clock text-primary mt-1 mr-3"></i>
          <div>
            <div class="font-semibold text-gray-900">Wait a Moment</div>
            <div class="text-sm text-gray-600">We might be working on it</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex gap-4 justify-center flex-wrap">
      <button
        onclick="location.reload()"
        class="px-6 py-3 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-semibold transition tap-target"
      >
        <i class="fas fa-redo mr-2"></i><%= __('common.cancel') %> & Try Again
      </button>

      <button
        onclick="window.history.back()"
        class="px-6 py-3 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-semibold transition tap-target"
      >
        <i class="fas fa-arrow-left mr-2"></i><%= __('common.back') %>
      </button>

      <a
        href="/"
        class="px-6 py-3 bg-primary hover:bg-blue-700 text-white rounded-lg font-semibold transition tap-target"
      >
        <i class="fas fa-home mr-2"></i><%= __('nav.home') %>
      </a>
    </div>

    <!-- Error Code Reference -->
    <div class="mt-8 bg-gray-100 rounded-lg p-4">
      <p class="text-sm text-gray-600">
        <strong>Error Code:</strong> <%= statusCode || 500 %>
      </p>
      <p class="text-xs text-gray-500 mt-1">
        Please include this code when reporting the issue
      </p>
    </div>

    <!-- Support Link -->
    <div class="mt-6 text-gray-500">
      <p class="text-sm">
        Need help? <a href="/contact" class="text-primary hover:underline font-semibold"><%= __('footer.contact') %></a>
      </p>
    </div>
  </div>

  <style>
    .tap-target {
      min-height: 44px;
      min-width: 44px;
    }
  </style>

</body>
</html>
