<!-- Faculty Form (Create/Edit) -->
<div class="max-w-3xl mx-auto space-y-6" x-data="facultyForm()">

  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">
        <i class="fas fa-building text-purple-600 mr-3"></i><%= pageTitle %>
      </h1>
      <p class="text-gray-600 mt-1">
        <%= faculty ? 'Update faculty information' : 'Add a new faculty to the system' %>
      </p>
    </div>
    <a href="/admin/faculties" class="inline-flex items-center px-4 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition">
      <i class="fas fa-arrow-left mr-2"></i>Back to List
    </a>
  </div>

  <!-- Form Card -->
  <div class="bg-white rounded-xl shadow-sm p-8">
    <form
      id="facultyForm"
      action="<%= action %>"
      method="POST"
      @submit="handleSubmit"
      novalidate
    >

      <!-- Name (Indonesian) - Required -->
      <div class="mb-6">
        <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
          Faculty Name (Indonesian) <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          x-model="form.name"
          required
          autofocus
          placeholder="e.g., Fakultas Teknik"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          :class="{'border-red-500': errors.name}"
        >
        <p x-show="errors.name" x-text="errors.name" class="mt-2 text-sm text-red-600"></p>
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Enter the official faculty name in Indonesian
        </p>
      </div>

      <!-- Name (English) - Optional -->
      <div class="mb-6">
        <label for="nameEn" class="block text-sm font-semibold text-gray-700 mb-2">
          Faculty Name (English)
        </label>
        <input
          type="text"
          id="nameEn"
          name="nameEn"
          x-model="form.nameEn"
          placeholder="e.g., Faculty of Engineering"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent"
        >
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Optional: English translation of the faculty name
        </p>
      </div>

      <!-- Code - Optional -->
      <div class="mb-6">
        <label for="code" class="block text-sm font-semibold text-gray-700 mb-2">
          Faculty Code
        </label>
        <input
          type="text"
          id="code"
          name="code"
          x-model="form.code"
          placeholder="e.g., FT"
          maxlength="10"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          :class="{'border-red-500': errors.code}"
        >
        <p x-show="errors.code" x-text="errors.code" class="mt-2 text-sm text-red-600"></p>
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Optional: Short code or abbreviation (max 10 characters)
        </p>
      </div>

      <!-- Description - Optional -->
      <div class="mb-6">
        <label for="description" class="block text-sm font-semibold text-gray-700 mb-2">
          Description
        </label>
        <textarea
          id="description"
          name="description"
          x-model="form.description"
          rows="4"
          placeholder="Enter a brief description of the faculty..."
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-none"
        ></textarea>
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Optional: Additional information about the faculty
        </p>
      </div>

      <!-- Required Fields Notice -->
      <div class="mb-6 p-4 bg-blue-50 border-l-4 border-blue-400 rounded">
        <div class="flex">
          <i class="fas fa-info-circle text-blue-400 mt-0.5 mr-3"></i>
          <div class="text-sm text-blue-700">
            <p class="font-medium">Required fields are marked with <span class="text-red-500">*</span></p>
            <p class="mt-1">Make sure to fill in all required fields before submitting</p>
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="flex items-center justify-end space-x-4 pt-6 border-t border-gray-200">
        <a
          href="/admin/faculties"
          class="px-6 py-3 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition"
          :class="{'opacity-50 pointer-events-none': isSubmitting}"
        >
          <i class="fas fa-times mr-2"></i>Cancel
        </a>
        <button
          type="submit"
          :disabled="isSubmitting"
          class="px-6 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-medium rounded-lg hover:from-purple-700 hover:to-indigo-700 transition shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span x-show="!isSubmitting">
            <i class="fas fa-save mr-2"></i><%= faculty ? 'Update Faculty' : 'Create Faculty' %>
          </span>
          <span x-show="isSubmitting" class="flex items-center">
            <i class="fas fa-spinner fa-spin mr-2"></i>Saving...
          </span>
        </button>
      </div>

    </form>
  </div>

  <!-- Help Tips -->
  <div class="bg-gradient-to-br from-purple-50 to-indigo-50 rounded-xl p-6 border border-purple-200">
    <h3 class="text-lg font-bold text-gray-900 mb-3">
      <i class="fas fa-lightbulb text-yellow-500 mr-2"></i>Tips
    </h3>
    <ul class="space-y-2 text-sm text-gray-700">
      <li class="flex items-start">
        <i class="fas fa-check-circle text-green-500 mr-2 mt-0.5"></i>
        <span>Use clear and official names for faculties</span>
      </li>
      <li class="flex items-start">
        <i class="fas fa-check-circle text-green-500 mr-2 mt-0.5"></i>
        <span>Faculty codes should be unique and easy to remember</span>
      </li>
      <li class="flex items-start">
        <i class="fas fa-check-circle text-green-500 mr-2 mt-0.5"></i>
        <span>Make sure to provide both Indonesian and English names for better accessibility</span>
      </li>
    </ul>
  </div>

</div>

<!-- Alpine.js Component -->
<script>
  function facultyForm() {
    return {
      form: {
        name: '<%= faculty ? faculty.name : "" %>',
        nameEn: '<%= faculty ? (faculty.nameEn || "") : "" %>',
        code: '<%= faculty ? (faculty.code || "") : "" %>',
        description: '<%= faculty ? (faculty.description || "") : "" %>'
      },
      errors: {},
      isSubmitting: false,

      handleSubmit(event) {
        // Clear previous errors
        this.errors = {};

        // Validate form
        if (!this.validateForm()) {
          event.preventDefault();
          return false;
        }

        // Set loading state
        this.isSubmitting = true;

        // Form will submit naturally
        return true;
      },

      validateForm() {
        let isValid = true;

        // Validate name (required)
        if (!this.form.name || this.form.name.trim() === '') {
          this.errors.name = 'Faculty name (Indonesian) is required';
          isValid = false;
        } else if (this.form.name.trim().length < 3) {
          this.errors.name = 'Faculty name must be at least 3 characters';
          isValid = false;
        }

        // Validate code (optional, but if provided must be valid)
        if (this.form.code && this.form.code.trim() !== '') {
          if (this.form.code.trim().length > 10) {
            this.errors.code = 'Faculty code must be maximum 10 characters';
            isValid = false;
          }
        }

        // Focus on first error field
        if (!isValid) {
          const firstErrorField = Object.keys(this.errors)[0];
          if (firstErrorField) {
            document.getElementById(firstErrorField)?.focus();
          }
        }

        return isValid;
      }
    }
  }
</script>
