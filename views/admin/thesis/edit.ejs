<!-- Admin Thesis Edit Form - Simplified Version -->
<div class="max-w-6xl mx-auto py-8 px-4">

  <!-- Header with Actions -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Edit Thesis</h1>
      <p class="text-sm text-gray-600 mt-1">
        Thesis ID: <%= thesis.id %> | Submitted by: <%= thesis.submitter.name %>
      </p>
    </div>
    <div class="flex space-x-3">
      <a href="/thesis/<%= thesis.id %>" target="_blank"
        class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
        <i class="fas fa-external-link-alt mr-2"></i>View Public Page
      </a>
      <a href="/admin/review?status=approved"
        class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700">
        <i class="fas fa-arrow-left mr-2"></i>Back to Review
      </a>
    </div>
  </div>

  <!-- Metadata Edit Form -->
  <form method="POST" action="/admin/thesis/<%= thesis.id %>/update">

    <!-- Basic Information -->
    <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">
        <i class="fas fa-info-circle mr-2"></i>Basic Information
      </h2>

      <div class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Title (Indonesian) <span class="text-red-500">*</span>
            </label>
            <input type="text" name="title" value="<%= thesis.title %>" required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Title (English)</label>
            <input type="text" name="titleEn" value="<%= thesis.titleEn || '' %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Author Name <span class="text-red-500">*</span>
            </label>
            <input type="text" name="authorName" value="<%= thesis.authorName %>" required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Student ID <span class="text-red-500">*</span>
            </label>
            <input type="text" name="studentId" value="<%= thesis.studentId %>" required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Graduation Year <span class="text-red-500">*</span>
            </label>
            <input type="number" name="graduationYear" value="<%= thesis.graduationYear %>" required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Department <span class="text-red-500">*</span>
            </label>
            <select name="departmentId" required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <% departments.forEach(dept => { %>
                <option value="<%= dept.id %>" <%= thesis.departmentId === dept.id ? 'selected' : '' %>>
                  <%= dept.name %> - <%= dept.faculty.name %>
                </option>
              <% }); %>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Defense Date</label>
            <input type="date" name="defenseDate"
              value="<%= thesis.defenseDate ? thesis.defenseDate.toISOString().split('T')[0] : '' %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Abstract (Indonesian) <span class="text-red-500">*</span>
            </label>
            <textarea name="abstractId" required rows="6"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"><%= thesis.abstractId %></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Abstract (English)</label>
            <textarea name="abstractEn" rows="6"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"><%= thesis.abstractEn || '' %></textarea>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Keywords (Indonesian) <span class="text-red-500">*</span>
            </label>
            <input type="text" name="keywords" value="<%= thesis.keywords %>" required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Keywords (English)</label>
            <input type="text" name="keywordsEn" value="<%= thesis.keywordsEn || '' %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
        </div>
      </div>
    </div>

    <!-- Advisors & Examiners -->
    <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">
        <i class="fas fa-users mr-2"></i>Advisors & Examiners
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            Main Advisor <span class="text-red-500">*</span>
          </label>
          <select name="advisor1Id" required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <% lecturers.forEach(lect => { %>
              <option value="<%= lect.id %>" <%= thesis.advisor1Id === lect.id ? 'selected' : '' %>>
                <%= lect.name %> - <%= lect.department.name %>
              </option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Co-Advisor</label>
          <select name="advisor2Id"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="">None (Optional)</option>
            <% lecturers.forEach(lect => { %>
              <option value="<%= lect.id %>" <%= thesis.advisor2Id === lect.id ? 'selected' : '' %>>
                <%= lect.name %> - <%= lect.department.name %>
              </option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Examiner 1</label>
          <select name="examiner1Id"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="">None (Optional)</option>
            <% lecturers.forEach(lect => { %>
              <option value="<%= lect.id %>" <%= thesis.examiner1Id === lect.id ? 'selected' : '' %>>
                <%= lect.name %> - <%= lect.department.name %>
              </option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Examiner 2</label>
          <select name="examiner2Id"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="">None (Optional)</option>
            <% lecturers.forEach(lect => { %>
              <option value="<%= lect.id %>" <%= thesis.examiner2Id === lect.id ? 'selected' : '' %>>
                <%= lect.name %> - <%= lect.department.name %>
              </option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Examiner 3</label>
          <select name="examiner3Id"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="">None (Optional)</option>
            <% lecturers.forEach(lect => { %>
              <option value="<%= lect.id %>" <%= thesis.examiner3Id === lect.id ? 'selected' : '' %>>
                <%= lect.name %> - <%= lect.department.name %>
              </option>
            <% }); %>
          </select>
        </div>
      </div>
    </div>

    <!-- Files Section (Display Only for Now) -->
    <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">
        <i class="fas fa-file mr-2"></i>Files
      </h2>

      <div class="space-y-3">
        <% thesis.files.forEach(file => { %>
          <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
            <div class="flex items-center space-x-3">
              <i class="fas fa-file-pdf text-red-500 text-2xl"></i>
              <div>
                <p class="font-medium text-gray-900"><%= file.fileLabel %></p>
                <p class="text-sm text-gray-500">
                  <%= file.originalFilename %> • <%= (file.fileSize / 1024 / 1024).toFixed(2) %> MB
                </p>
                <p class="text-xs text-gray-600 mt-1">
                  <span class="px-2 py-0.5 bg-<%= file.accessLevel === 'PUBLIC' ? 'green' : file.accessLevel === 'EMBARGOED' ? 'yellow' : 'red' %>-100 text-<%= file.accessLevel === 'PUBLIC' ? 'green' : file.accessLevel === 'EMBARGOED' ? 'yellow' : 'red' %>-800 rounded">
                    <%= file.accessLevel %>
                  </span>
                  <% if (file.embargoUntil) { %>
                    • Until: <%= file.embargoUntil.toLocaleDateString() %>
                  <% } %>
                </p>
              </div>
            </div>
          </div>
        <% }); %>
      </div>

      <div class="mt-4 p-4 bg-blue-50 border-l-4 border-blue-500 rounded">
        <p class="text-sm text-blue-900">
          <i class="fas fa-info-circle mr-2"></i>
          <strong>File Management:</strong> File editing (add/delete/update) will be available in future version.
          For now, use API endpoints or contact system administrator.
        </p>
      </div>
    </div>

    <!-- Submit Buttons -->
    <div class="flex justify-end space-x-4">
      <a href="/admin/review?status=approved"
        class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 font-medium">
        Cancel
      </a>
      <button type="submit"
        class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium">
        <i class="fas fa-save mr-2"></i>Save Changes
      </button>
    </div>

  </form>

</div>
