<!-- Statistics Dashboard -->
<div class="container-fluid">
  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Statistics Dashboard</h1>
    <div>
      <a href="/admin/statistics/export?format=csv" class="btn btn-success btn-sm">
        <i class="fas fa-file-csv"></i> Export CSV
      </a>
      <a href="/admin/statistics/export?format=json" class="btn btn-info btn-sm">
        <i class="fas fa-file-code"></i> Export JSON
      </a>
    </div>
  </div>

  <!-- Overview Cards -->
  <div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-primary shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Theses</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.totalTheses.toLocaleString() %></div>
            </div>
            <div class="col-auto">
              <i class="fas fa-book fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-success shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Views</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.totalViews.toLocaleString() %></div>
            </div>
            <div class="col-auto">
              <i class="fas fa-eye fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-info shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Total Downloads</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.totalDownloads.toLocaleString() %></div>
            </div>
            <div class="col-auto">
              <i class="fas fa-download fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-warning shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">This Month</div>
              <div class="h6 mb-0 font-weight-bold text-gray-800">
                <%= stats.viewsThisMonth %> views | <%= stats.downloadsThisMonth %> downloads
              </div>
            </div>
            <div class="col-auto">
              <i class="fas fa-calendar fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="row mb-4">
    <!-- Views & Downloads Chart -->
    <div class="col-xl-8 col-lg-7">
      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">Views & Downloads (Last 30 Days)</h6>
        </div>
        <div class="card-body">
          <canvas id="viewsDownloadsChart" height="100"></canvas>
        </div>
      </div>
    </div>

    <!-- Faculty Distribution Chart -->
    <div class="col-xl-4 col-lg-5">
      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">Theses by Faculty</h6>
        </div>
        <div class="card-body">
          <canvas id="facultyChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Top Content Tables -->
  <div class="row">
    <!-- Most Viewed Theses -->
    <div class="col-xl-6 col-lg-12 mb-4">
      <div class="card shadow">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">Top 10 Most Viewed Theses</h6>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-sm table-hover">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Title</th>
                  <th>Author</th>
                  <th>Year</th>
                  <th class="text-right">Views</th>
                </tr>
              </thead>
              <tbody>
                <% mostViewed.forEach((thesis, index) => { %>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td>
                      <a href="/thesis/<%= thesis.id %>" target="_blank" class="text-truncate d-inline-block" style="max-width: 300px;">
                        <%= thesis.title %>
                      </a>
                    </td>
                    <td><%= thesis.submitter.name %></td>
                    <td><%= thesis.graduationYear %></td>
                    <td class="text-right"><strong><%= thesis.viewCount %></strong></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Most Downloaded Theses -->
    <div class="col-xl-6 col-lg-12 mb-4">
      <div class="card shadow">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">Top 10 Most Downloaded Theses</h6>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-sm table-hover">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Title</th>
                  <th>Author</th>
                  <th>Year</th>
                  <th class="text-right">Downloads</th>
                </tr>
              </thead>
              <tbody>
                <% mostDownloaded.forEach((thesis, index) => { %>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td>
                      <a href="/thesis/<%= thesis.id %>" target="_blank" class="text-truncate d-inline-block" style="max-width: 300px;">
                        <%= thesis.title %>
                      </a>
                    </td>
                    <td><%= thesis.submitter.name %></td>
                    <td><%= thesis.graduationYear %></td>
                    <td class="text-right"><strong><%= thesis.downloadCount %></strong></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="row">
    <div class="col-12">
      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">Recent Activity (Last 50 Events)</h6>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-sm table-hover">
              <thead>
                <tr>
                  <th>Timestamp</th>
                  <th>Event</th>
                  <th>Thesis</th>
                  <th>IP Hash</th>
                  <th>User Agent</th>
                </tr>
              </thead>
              <tbody>
                <% recentActivity.forEach(log => { %>
                  <tr>
                    <td><small><%= new Date(log.createdAt).toLocaleString() %></small></td>
                    <td>
                      <% if (log.eventType === 'VIEW') { %>
                        <span class="badge badge-success">VIEW</span>
                      <% } else if (log.eventType === 'DOWNLOAD') { %>
                        <span class="badge badge-info">DOWNLOAD</span>
                      <% } else if (log.eventType === 'PREVIEW') { %>
                        <span class="badge badge-warning">PREVIEW</span>
                      <% } else { %>
                        <span class="badge badge-secondary"><%= log.eventType %></span>
                      <% } %>
                    </td>
                    <td>
                      <% if (log.thesis) { %>
                        <a href="/thesis/<%= log.thesis.id %>" target="_blank" class="text-truncate d-inline-block" style="max-width: 400px;">
                          <%= log.thesis.title %>
                        </a>
                      <% } else { %>
                        <em>N/A</em>
                      <% } %>
                    </td>
                    <td><small class="text-muted"><%= log.ipHash.substring(0, 16) %>...</small></td>
                    <td><small class="text-muted text-truncate d-inline-block" style="max-width: 200px;"><%= log.userAgent || 'N/A' %></small></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

<script>
// Parse chart data
const chartData = JSON.parse('<%- chartData %>');

// Views & Downloads Line Chart
const ctxLine = document.getElementById('viewsDownloadsChart').getContext('2d');
const dailyDates = chartData.dailyStats.map(stat => new Date(stat.date).toLocaleDateString());
const dailyViews = chartData.dailyStats.map(stat => Number(stat.views));
const dailyDownloads = chartData.dailyStats.map(stat => Number(stat.downloads));

new Chart(ctxLine, {
  type: 'line',
  data: {
    labels: dailyDates,
    datasets: [
      {
        label: 'Views',
        data: dailyViews,
        borderColor: 'rgb(75, 192, 192)',
        backgroundColor: 'rgba(75, 192, 192, 0.2)',
        tension: 0.1
      },
      {
        label: 'Downloads',
        data: dailyDownloads,
        borderColor: 'rgb(255, 99, 132)',
        backgroundColor: 'rgba(255, 99, 132, 0.2)',
        tension: 0.1
      }
    ]
  },
  options: {
    responsive: true,
    plugins: {
      legend: {
        position: 'top',
      },
      title: {
        display: false
      }
    },
    scales: {
      y: {
        beginAtZero: true
      }
    }
  }
});

// Faculty Bar Chart
const ctxBar = document.getElementById('facultyChart').getContext('2d');
const facultyNames = chartData.facultyStats.map(f => f.name);
const facultyTheses = chartData.facultyStats.map(f => f.thesisCount);

new Chart(ctxBar, {
  type: 'bar',
  data: {
    labels: facultyNames,
    datasets: [{
      label: 'Number of Theses',
      data: facultyTheses,
      backgroundColor: 'rgba(54, 162, 235, 0.5)',
      borderColor: 'rgba(54, 162, 235, 1)',
      borderWidth: 1
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: true,
    plugins: {
      legend: {
        display: false
      }
    },
    scales: {
      y: {
        beginAtZero: true,
        ticks: {
          stepSize: 1
        }
      },
      x: {
        ticks: {
          callback: function(value) {
            const label = this.getLabelForValue(value);
            return label.length > 15 ? label.substring(0, 15) + '...' : label;
          }
        }
      }
    }
  }
});
</script>
