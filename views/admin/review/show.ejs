<!-- Detailed Review Page - Split Layout -->
<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <a
            href="/admin/review"
            class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Review Queue
          </a>
        </div>
        <div class="flex items-center space-x-3">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
            <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
            </svg>
            Pending Review
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content - Split Layout -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
      <!-- LEFT PANEL (60% - 3 columns) -->
      <div class="lg:col-span-3 space-y-6">
        <!-- Section 1: Basic Info -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Basic Information</h2>
          </div>
          <div class="px-6 py-4 space-y-4">
            <!-- Title -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Title (Indonesian)</label>
              <p class="text-base text-gray-900"><%= thesis.title %></p>
            </div>

            <% if (thesis.titleEn) { %>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Title (English)</label>
                <p class="text-base text-gray-900"><%= thesis.titleEn %></p>
              </div>
            <% } %>

            <!-- Author Info -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Author Name</label>
                <p class="text-base text-gray-900"><%= thesis.authorName %></p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Student ID</label>
                <p class="text-base text-gray-900"><%= thesis.studentId %></p>
              </div>
            </div>

            <!-- Department & Year -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Department</label>
                <p class="text-base text-gray-900"><%= thesis.department.name %></p>
                <p class="text-sm text-gray-500"><%= thesis.department.faculty.name %></p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Graduation Year</label>
                <p class="text-base text-gray-900"><%= thesis.graduationYear %></p>
              </div>
            </div>

            <!-- Defense Date -->
            <% if (thesis.defenseDate) { %>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Defense Date</label>
                <p class="text-base text-gray-900">
                  <%= new Date(thesis.defenseDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </p>
              </div>
            <% } %>

            <!-- Submitted Date -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Submitted Date</label>
              <p class="text-base text-gray-900"><%= formattedSubmittedDate %></p>
            </div>
          </div>
        </div>

        <!-- Section 2: Abstract (Collapsible) -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200" x-data="{ open: false }">
          <div class="px-6 py-4 border-b border-gray-200">
            <button
              @click="open = !open"
              class="flex items-center justify-between w-full text-left"
            >
              <h2 class="text-lg font-semibold text-gray-900">Abstract</h2>
              <svg
                class="w-5 h-5 text-gray-500 transform transition-transform"
                :class="{ 'rotate-180': open }"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
          <div x-show="open" x-collapse class="px-6 py-4 space-y-4">
            <!-- Abstract ID -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Abstract (Indonesian)</label>
              <div class="prose prose-sm max-w-none text-gray-900 whitespace-pre-wrap">
<%= thesis.abstractId %></div>
            </div>

            <% if (thesis.abstractEn) { %>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Abstract (English)</label>
                <div class="prose prose-sm max-w-none text-gray-900 whitespace-pre-wrap">
<%= thesis.abstractEn %></div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Section 3: Keywords (as tags) -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Keywords</h2>
          </div>
          <div class="px-6 py-4 space-y-4">
            <!-- Keywords ID -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Keywords (Indonesian)</label>
              <div class="flex flex-wrap gap-2">
                <% keywords.forEach(keyword => { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                    <%= keyword %>
                  </span>
                <% }); %>
              </div>
            </div>

            <% if (keywordsEn.length > 0) { %>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Keywords (English)</label>
                <div class="flex flex-wrap gap-2">
                  <% keywordsEn.forEach(keyword => { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                      <%= keyword %>
                    </span>
                  <% }); %>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Section 4: Advisors & Examiners -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Advisors & Examiners</h2>
          </div>
          <div class="px-6 py-4 space-y-4">
            <!-- Advisors -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Advisors</label>
              <div class="space-y-2">
                <div class="flex items-center p-3 bg-blue-50 rounded-lg">
                  <div class="flex-shrink-0">
                    <div class="h-10 w-10 rounded-full bg-blue-200 flex items-center justify-center">
                      <span class="text-sm font-medium text-blue-700">A1</span>
                    </div>
                  </div>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-gray-900"><%= thesis.advisor1.name %></p>
                    <p class="text-xs text-gray-500"><%= thesis.advisor1.department.name %></p>
                  </div>
                </div>

                <% if (thesis.advisor2) { %>
                  <div class="flex items-center p-3 bg-blue-50 rounded-lg">
                    <div class="flex-shrink-0">
                      <div class="h-10 w-10 rounded-full bg-blue-200 flex items-center justify-center">
                        <span class="text-sm font-medium text-blue-700">A2</span>
                      </div>
                    </div>
                    <div class="ml-3">
                      <p class="text-sm font-medium text-gray-900"><%= thesis.advisor2.name %></p>
                      <p class="text-xs text-gray-500"><%= thesis.advisor2.department.name %></p>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Examiners -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Examiners</label>
              <div class="space-y-2">
                <div class="flex items-center p-3 bg-green-50 rounded-lg">
                  <div class="flex-shrink-0">
                    <div class="h-10 w-10 rounded-full bg-green-200 flex items-center justify-center">
                      <span class="text-sm font-medium text-green-700">E1</span>
                    </div>
                  </div>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-gray-900"><%= thesis.examiner1.name %></p>
                    <p class="text-xs text-gray-500"><%= thesis.examiner1.department.name %></p>
                  </div>
                </div>

                <% if (thesis.examiner2) { %>
                  <div class="flex items-center p-3 bg-green-50 rounded-lg">
                    <div class="flex-shrink-0">
                      <div class="h-10 w-10 rounded-full bg-green-200 flex items-center justify-center">
                        <span class="text-sm font-medium text-green-700">E2</span>
                      </div>
                    </div>
                    <div class="ml-3">
                      <p class="text-sm font-medium text-gray-900"><%= thesis.examiner2.name %></p>
                      <p class="text-xs text-gray-500"><%= thesis.examiner2.department.name %></p>
                    </div>
                  </div>
                <% } %>

                <% if (thesis.examiner3) { %>
                  <div class="flex items-center p-3 bg-green-50 rounded-lg">
                    <div class="flex-shrink-0">
                      <div class="h-10 w-10 rounded-full bg-green-200 flex items-center justify-center">
                        <span class="text-sm font-medium text-green-700">E3</span>
                      </div>
                    </div>
                    <div class="ml-3">
                      <p class="text-sm font-medium text-gray-900"><%= thesis.examiner3.name %></p>
                      <p class="text-xs text-gray-500"><%= thesis.examiner3.department.name %></p>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT PANEL (40% - 2 columns) -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Bulk Embargo Button -->
        <div class="flex justify-end">
          <button
            type="button"
            onclick="openBulkEmbargoModal()"
            class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Apply Embargo to All Files
          </button>
        </div>

        <!-- Files List -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 sticky top-6">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Uploaded Files</h2>
            <p class="text-sm text-gray-500 mt-1"><%= files.length %> files uploaded</p>
          </div>
          <div class="divide-y divide-gray-200">
            <% files.forEach(file => { %>
              <div class="px-6 py-4" id="file-<%= file.id %>">
                <div class="flex items-start justify-between">
                  <div class="flex-1 min-w-0">
                    <!-- File Type Badge -->
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800 mb-2">
                      <%= file.typeLabel %>
                    </span>

                    <!-- Filename -->
                    <p class="text-sm font-medium text-gray-900 truncate" title="<%= file.originalFilename %>">
                      <%= file.originalFilename %>
                    </p>

                    <!-- File Size -->
                    <p class="text-xs text-gray-500 mt-1">
                      Size: <%= file.sizeFormatted %>
                    </p>

                    <!-- Download Count -->
                    <p class="text-xs text-gray-400 mt-1">
                      <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                      </svg>
                      <%= file.downloadCount %> downloads
                    </p>
                  </div>
                </div>

                <!-- Embargo Status Badge -->
                <div class="mt-3" id="embargo-status-<%= file.id %>">
                  <% if (file.accessLevel === 'EMBARGOED' && file.embargoUntil) { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                      🟡 Embargoed until <%= new Date(file.embargoUntil).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                    </span>
                  <% } else if (file.accessLevel === 'RESTRICTED') { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      🔴 Restricted Access
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      🟢 Open Access
                    </span>
                  <% } %>
                </div>

                <!-- Embargo Controls -->
                <div class="mt-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
                  <label class="block text-xs font-medium text-gray-700 mb-2">Access Level</label>

                  <div class="space-y-2">
                    <!-- Public -->
                    <label class="flex items-center">
                      <input
                        type="radio"
                        name="accessLevel-<%= file.id %>"
                        value="PUBLIC"
                        <%= file.accessLevel === 'PUBLIC' ? 'checked' : '' %>
                        onchange="updateEmbargoUI(<%= file.id %>, 'PUBLIC')"
                        class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300"
                      >
                      <span class="ml-2 text-sm text-gray-700">Public</span>
                    </label>

                    <!-- Embargoed -->
                    <label class="flex items-start">
                      <input
                        type="radio"
                        name="accessLevel-<%= file.id %>"
                        value="EMBARGOED"
                        <%= file.accessLevel === 'EMBARGOED' ? 'checked' : '' %>
                        onchange="updateEmbargoUI(<%= file.id %>, 'EMBARGOED')"
                        class="h-4 w-4 mt-0.5 text-blue-600 focus:ring-blue-500 border-gray-300"
                      >
                      <div class="ml-2 flex-1">
                        <span class="text-sm text-gray-700">Embargoed until:</span>
                        <input
                          type="date"
                          id="embargoDate-<%= file.id %>"
                          value="<%= file.embargoUntil ? new Date(file.embargoUntil).toISOString().split('T')[0] : '' %>"
                          min="<%= new Date().toISOString().split('T')[0] %>"
                          class="mt-1 block w-full text-sm rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                        >
                        <textarea
                          id="embargoReason-<%= file.id %>"
                          rows="2"
                          placeholder="Reason (optional)"
                          class="mt-2 block w-full text-sm rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                        ><%= file.embargoReason || '' %></textarea>
                      </div>
                    </label>

                    <!-- Restricted -->
                    <label class="flex items-center">
                      <input
                        type="radio"
                        name="accessLevel-<%= file.id %>"
                        value="RESTRICTED"
                        <%= file.accessLevel === 'RESTRICTED' ? 'checked' : '' %>
                        onchange="updateEmbargoUI(<%= file.id %>, 'RESTRICTED')"
                        class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300"
                      >
                      <span class="ml-2 text-sm text-gray-700">Restricted (Admin only)</span>
                    </label>
                  </div>

                  <!-- Save Button -->
                  <button
                    type="button"
                    onclick="saveEmbargoSettings(<%= file.id %>)"
                    class="mt-3 w-full inline-flex justify-center items-center px-3 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                  >
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Save Settings
                  </button>
                </div>

                <!-- Actions -->
                <div class="mt-3 flex items-center space-x-2">
                  <button
                    onclick="previewFile(<%= thesis.id %>, <%= file.id %>, '<%= file.originalFilename %>')"
                    class="flex-1 inline-flex items-center justify-center px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                  >
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    Preview
                  </button>

                  <a
                    href="/admin/review/<%= thesis.id %>/download/<%= file.id %>"
                    class="flex-1 inline-flex items-center justify-center px-3 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                    download
                  >
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    Download
                  </a>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>

    <!-- BOTTOM PANEL: Review Actions -->
    <div class="mt-6 bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Review Actions</h2>
        <p class="text-sm text-gray-500 mt-1">Make a decision on this thesis submission</p>
      </div>
      <div class="px-6 py-4">
        <div class="flex items-center justify-end space-x-3">
          <a
            href="/admin/review"
            class="inline-flex items-center px-6 py-3 border border-gray-300 rounded-lg text-base font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500"
          >
            Cancel
          </a>

          <!-- Request Changes Button -->
          <button
            type="button"
            onclick="openRequestChangesModal()"
            class="inline-flex items-center px-6 py-3 border border-transparent rounded-lg text-base font-medium text-white bg-yellow-600 hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Request Changes
          </button>

          <!-- Reject Button -->
          <button
            type="button"
            onclick="openRejectModal()"
            class="inline-flex items-center px-6 py-3 border border-transparent rounded-lg text-base font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Reject
          </button>

          <!-- Approve Button -->
          <button
            type="button"
            onclick="confirmApprove()"
            class="inline-flex items-center px-6 py-3 border border-transparent rounded-lg text-base font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Approve & Publish
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- PDF Preview Modal -->
<div
  id="pdfModal"
  class="fixed inset-0 z-50 hidden overflow-y-auto"
  aria-labelledby="modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <!-- Background overlay -->
    <div
      class="fixed inset-0 transition-opacity bg-gray-500 bg-opacity-75"
      aria-hidden="true"
      onclick="closePdfModal()"
    ></div>

    <!-- Modal panel -->
    <div class="inline-block w-full h-screen max-w-7xl align-middle transition-all transform bg-white shadow-xl">
      <!-- Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900" id="modalFileName">PDF Preview</h3>
        <div class="flex items-center space-x-2">
          <button
            onclick="closePdfModal()"
            class="inline-flex items-center p-2 text-gray-400 hover:text-gray-500 focus:outline-none"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- PDF Viewer -->
      <div class="relative" style="height: calc(100vh - 80px);">
        <iframe
          id="pdfViewer"
          class="w-full h-full"
          frameborder="0"
        ></iframe>
      </div>
    </div>
  </div>
</div>

<!-- Request Changes Modal -->
<div
  id="requestChangesModal"
  class="fixed inset-0 z-50 hidden overflow-y-auto"
  aria-labelledby="modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <!-- Background overlay -->
    <div
      class="fixed inset-0 transition-opacity bg-gray-500 bg-opacity-75"
      aria-hidden="true"
      onclick="closeRequestChangesModal()"
    ></div>

    <!-- Modal panel -->
    <div class="inline-block w-full max-w-2xl p-6 my-8 overflow-hidden text-left align-middle transition-all transform bg-white shadow-xl rounded-lg">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-900">Request Changes</h3>
        <button
          type="button"
          onclick="closeRequestChangesModal()"
          class="text-gray-400 hover:text-gray-500"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form action="/admin/review/<%= thesis.id %>/request-changes" method="POST" id="requestChangesForm">
        <div class="mb-4">
          <label for="reviewerNotes" class="block text-sm font-medium text-gray-700 mb-2">
            Notes for Student <span class="text-red-500">*</span>
          </label>
          <textarea
            id="reviewerNotes"
            name="reviewerNotes"
            rows="6"
            required
            minlength="50"
            class="w-full rounded-lg border-gray-300 shadow-sm focus:border-yellow-500 focus:ring-yellow-500"
            placeholder="Provide detailed feedback on what needs to be changed... (minimum 50 characters)"
          ></textarea>
          <p class="mt-1 text-sm text-gray-500">
            <span id="notesCharCount">0</span> / 50 characters minimum
          </p>
        </div>

        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-yellow-700">
                The thesis will be sent back to DRAFT status. The student will be able to make changes and re-submit.
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end space-x-3">
          <button
            type="button"
            onclick="closeRequestChangesModal()"
            class="px-6 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="px-6 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-yellow-600 hover:bg-yellow-700"
          >
            Submit Request
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div
  id="rejectModal"
  class="fixed inset-0 z-50 hidden overflow-y-auto"
  aria-labelledby="modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <!-- Background overlay -->
    <div
      class="fixed inset-0 transition-opacity bg-gray-500 bg-opacity-75"
      aria-hidden="true"
      onclick="closeRejectModal()"
    ></div>

    <!-- Modal panel -->
    <div class="inline-block w-full max-w-2xl p-6 my-8 overflow-hidden text-left align-middle transition-all transform bg-white shadow-xl rounded-lg">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-900">Reject Thesis Submission</h3>
        <button
          type="button"
          onclick="closeRejectModal()"
          class="text-gray-400 hover:text-gray-500"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form action="/admin/review/<%= thesis.id %>/reject" method="POST" id="rejectForm">
        <div class="mb-4">
          <label for="rejectionReason" class="block text-sm font-medium text-gray-700 mb-2">
            Rejection Reason <span class="text-red-500">*</span>
          </label>
          <textarea
            id="rejectionReason"
            name="rejectionReason"
            rows="6"
            required
            minlength="50"
            class="w-full rounded-lg border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500"
            placeholder="Provide a detailed reason for rejection... (minimum 50 characters)"
          ></textarea>
          <p class="mt-1 text-sm text-gray-500">
            <span id="rejectCharCount">0</span> / 50 characters minimum
          </p>
        </div>

        <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm font-semibold text-red-800">Warning: This action cannot be undone</p>
              <p class="text-sm text-red-700 mt-1">
                The thesis will be permanently rejected and will NOT be published. The student cannot re-submit this particular thesis.
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end space-x-3">
          <button
            type="button"
            onclick="closeRejectModal()"
            class="px-6 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="px-6 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-red-600 hover:bg-red-700"
          >
            Reject Thesis
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Bulk Embargo Modal -->
<div
  id="bulkEmbargoModal"
  class="fixed inset-0 z-50 hidden overflow-y-auto"
  aria-labelledby="modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <!-- Background overlay -->
    <div
      class="fixed inset-0 transition-opacity bg-gray-500 bg-opacity-75"
      aria-hidden="true"
      onclick="closeBulkEmbargoModal()"
    ></div>

    <!-- Modal panel -->
    <div class="inline-block w-full max-w-2xl p-6 my-8 overflow-hidden text-left align-middle transition-all transform bg-white shadow-xl rounded-lg">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-900">Apply Embargo to All Files</h3>
        <button
          type="button"
          onclick="closeBulkEmbargoModal()"
          class="text-gray-400 hover:text-gray-500"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="bulkEmbargoForm" onsubmit="event.preventDefault(); saveBulkEmbargo();">
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Access Level <span class="text-red-500">*</span>
          </label>

          <div class="space-y-2">
            <!-- Public -->
            <label class="flex items-center p-3 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50">
              <input
                type="radio"
                name="bulkAccessLevel"
                value="PUBLIC"
                checked
                onchange="updateBulkEmbargoUI('PUBLIC')"
                class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300"
              >
              <span class="ml-2 text-sm font-medium text-gray-700">Public - Open Access</span>
            </label>

            <!-- Embargoed -->
            <label class="flex items-start p-3 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50">
              <input
                type="radio"
                name="bulkAccessLevel"
                value="EMBARGOED"
                onchange="updateBulkEmbargoUI('EMBARGOED')"
                class="h-4 w-4 mt-0.5 text-blue-600 focus:ring-blue-500 border-gray-300"
              >
              <div class="ml-2 flex-1">
                <span class="text-sm font-medium text-gray-700">Embargoed</span>
                <div id="bulkEmbargoFields" class="mt-2 space-y-2" style="display: none;">
                  <div>
                    <label for="bulkEmbargoDate" class="block text-xs font-medium text-gray-700 mb-1">
                      Embargo until <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="date"
                      id="bulkEmbargoDate"
                      min="<%= new Date().toISOString().split('T')[0] %>"
                      value="<%= new Date(new Date().setFullYear(new Date().getFullYear() + 1)).toISOString().split('T')[0] %>"
                      class="block w-full text-sm rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                    >
                  </div>
                  <div>
                    <label for="bulkEmbargoReason" class="block text-xs font-medium text-gray-700 mb-1">
                      Reason (optional)
                    </label>
                    <textarea
                      id="bulkEmbargoReason"
                      rows="3"
                      placeholder="Enter reason for embargo..."
                      class="block w-full text-sm rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                    ></textarea>
                  </div>
                </div>
              </div>
            </label>

            <!-- Restricted -->
            <label class="flex items-center p-3 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50">
              <input
                type="radio"
                name="bulkAccessLevel"
                value="RESTRICTED"
                onchange="updateBulkEmbargoUI('RESTRICTED')"
                class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300"
              >
              <span class="ml-2 text-sm font-medium text-gray-700">Restricted - Admin Only</span>
            </label>
          </div>
        </div>

        <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-blue-700">
                This will apply the selected embargo settings to <strong>all <%= files.length %> files</strong> in this thesis.
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end space-x-3">
          <button
            type="button"
            onclick="closeBulkEmbargoModal()"
            class="px-6 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="px-6 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-700"
          >
            Apply to All Files
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // PDF Preview Modal Functions
  function previewFile(thesisId, fileId, filename) {
    const modal = document.getElementById('pdfModal');
    const viewer = document.getElementById('pdfViewer');
    const fileNameElement = document.getElementById('modalFileName');

    // Set filename in header
    fileNameElement.textContent = filename;

    // Set iframe source
    viewer.src = `/admin/review/${thesisId}/preview/${fileId}`;

    // Show modal
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closePdfModal() {
    const modal = document.getElementById('pdfModal');
    const viewer = document.getElementById('pdfViewer');

    // Hide modal
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';

    // Clear iframe
    viewer.src = '';
  }

  // Request Changes Modal Functions
  function openRequestChangesModal() {
    const modal = document.getElementById('requestChangesModal');
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    // Reset form
    document.getElementById('requestChangesForm').reset();
    document.getElementById('notesCharCount').textContent = '0';
  }

  function closeRequestChangesModal() {
    const modal = document.getElementById('requestChangesModal');
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Reject Modal Functions
  function openRejectModal() {
    const modal = document.getElementById('rejectModal');
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    // Reset form
    document.getElementById('rejectForm').reset();
    document.getElementById('rejectCharCount').textContent = '0';
  }

  function closeRejectModal() {
    const modal = document.getElementById('rejectModal');
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Approve Confirmation
  function confirmApprove() {
    if (confirm('Are you sure you want to approve and publish this thesis to the public?\n\nThis will make the thesis visible to everyone.')) {
      // Create form and submit
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/admin/review/<%= thesis.id %>/approve';
      document.body.appendChild(form);
      form.submit();
    }
  }

  // Character counters
  document.getElementById('reviewerNotes')?.addEventListener('input', function(e) {
    document.getElementById('notesCharCount').textContent = e.target.value.length;
  });

  document.getElementById('rejectionReason')?.addEventListener('input', function(e) {
    document.getElementById('rejectCharCount').textContent = e.target.value.length;
  });

  // Embargo Functions
  function updateEmbargoUI(fileId, accessLevel) {
    const embargoDate = document.getElementById('embargoDate-' + fileId);
    const embargoReason = document.getElementById('embargoReason-' + fileId);

    if (accessLevel === 'EMBARGOED') {
      embargoDate.disabled = false;
      embargoReason.disabled = false;
    } else {
      embargoDate.disabled = true;
      embargoReason.disabled = true;
    }
  }

  async function saveEmbargoSettings(fileId) {
    const accessLevel = document.querySelector('input[name="accessLevel-' + fileId + '"]:checked').value;
    const embargoDate = document.getElementById('embargoDate-' + fileId).value;
    const embargoReason = document.getElementById('embargoReason-' + fileId).value;

    // Validate embargo date if EMBARGOED
    if (accessLevel === 'EMBARGOED' && !embargoDate) {
      alert('Please select an embargo date');
      return;
    }

    const data = {
      accessLevel: accessLevel,
      embargoUntil: accessLevel === 'EMBARGOED' ? embargoDate : null,
      embargoReason: accessLevel === 'EMBARGOED' ? embargoReason : null,
    };

    try {
      const response = await fetch('/admin/review/<%= thesis.id %>/files/' + fileId + '/embargo', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (result.success) {
        // Update embargo status badge
        updateEmbargoStatusBadge(fileId, result.file);
        alert('Embargo settings saved successfully!');
      } else {
        alert('Error: ' + result.message);
      }
    } catch (error) {
      console.error('Error saving embargo settings:', error);
      alert('Failed to save embargo settings');
    }
  }

  function updateEmbargoStatusBadge(fileId, file) {
    const statusElement = document.getElementById('embargo-status-' + fileId);
    let badgeHTML = '';

    if (file.accessLevel === 'EMBARGOED' && file.embargoUntil) {
      const embargoDate = new Date(file.embargoUntil);
      const formattedDate = embargoDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      });
      badgeHTML = `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
        🟡 Embargoed until ${formattedDate}
      </span>`;
    } else if (file.accessLevel === 'RESTRICTED') {
      badgeHTML = `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
        🔴 Restricted Access
      </span>`;
    } else {
      badgeHTML = `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
        🟢 Open Access
      </span>`;
    }

    statusElement.innerHTML = badgeHTML;
  }

  // Bulk Embargo Modal Functions
  function openBulkEmbargoModal() {
    const modal = document.getElementById('bulkEmbargoModal');
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    // Reset form
    document.getElementById('bulkEmbargoForm').reset();
    updateBulkEmbargoUI('PUBLIC');
  }

  function closeBulkEmbargoModal() {
    const modal = document.getElementById('bulkEmbargoModal');
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  function updateBulkEmbargoUI(accessLevel) {
    const bulkEmbargoFields = document.getElementById('bulkEmbargoFields');

    if (accessLevel === 'EMBARGOED') {
      bulkEmbargoFields.style.display = 'block';
    } else {
      bulkEmbargoFields.style.display = 'none';
    }
  }

  async function saveBulkEmbargo() {
    const accessLevel = document.querySelector('input[name="bulkAccessLevel"]:checked').value;
    const embargoDate = document.getElementById('bulkEmbargoDate').value;
    const embargoReason = document.getElementById('bulkEmbargoReason').value;

    // Validate embargo date if EMBARGOED
    if (accessLevel === 'EMBARGOED' && !embargoDate) {
      alert('Please select an embargo date');
      return;
    }

    const data = {
      accessLevel: accessLevel,
      embargoUntil: accessLevel === 'EMBARGOED' ? embargoDate : null,
      embargoReason: accessLevel === 'EMBARGOED' ? embargoReason : null,
    };

    try {
      const response = await fetch('/admin/review/<%= thesis.id %>/files/bulk-embargo', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (result.success) {
        closeBulkEmbargoModal();
        alert('Embargo settings applied to ' + result.count + ' files successfully!');
        // Reload page to show updated embargo settings
        window.location.reload();
      } else {
        alert('Error: ' + result.message);
      }
    } catch (error) {
      console.error('Error saving bulk embargo settings:', error);
      alert('Failed to save bulk embargo settings');
    }
  }

  // Close modals on ESC key
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      closePdfModal();
      closeRequestChangesModal();
      closeRejectModal();
      closeBulkEmbargoModal();
    }
  });
</script>
