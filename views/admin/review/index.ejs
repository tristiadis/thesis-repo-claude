<!-- Review Queue - List of Pending Theses -->
<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Review Queue</h1>
          <p class="mt-2 text-sm text-gray-600">
            Review and approve pending thesis submissions
          </p>
        </div>
        <div class="flex items-center space-x-4">
          <!-- Stats Card -->
          <div class="bg-white rounded-lg shadow px-6 py-4 border-l-4 border-blue-500">
            <div class="text-sm text-gray-600">Pending Review</div>
            <div class="text-3xl font-bold text-blue-600"><%= stats.total %></div>
            <% if (stats.today > 0) { %>
              <div class="text-xs text-gray-500 mt-1"><%= stats.today %> submitted today</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
      <form method="GET" action="/admin/review" class="flex flex-wrap items-center gap-4">
        <!-- Department Filter -->
        <div class="flex-1 min-w-[200px]">
          <label for="department" class="block text-sm font-medium text-gray-700 mb-1">
            Filter by Department
          </label>
          <select
            id="department"
            name="department"
            class="w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
            onchange="this.form.submit()"
          >
            <option value="all" <%= selectedDepartment === 'all' ? 'selected' : '' %>>
              All Departments
            </option>
            <% departments.forEach(dept => { %>
              <option
                value="<%= dept.id %>"
                <%= selectedDepartment == dept.id ? 'selected' : '' %>
              >
                <%= dept.name %> (<%= dept.faculty.name %>)
              </option>
            <% }); %>
          </select>
        </div>

        <!-- Sort Filter -->
        <div class="flex-1 min-w-[200px]">
          <label for="sort" class="block text-sm font-medium text-gray-700 mb-1">
            Sort By
          </label>
          <select
            id="sort"
            name="sort"
            class="w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
            onchange="this.form.submit()"
          >
            <option value="oldest" <%= selectedSort === 'oldest' ? 'selected' : '' %>>
              Oldest First
            </option>
            <option value="newest" <%= selectedSort === 'newest' ? 'selected' : '' %>>
              Newest First
            </option>
          </select>
        </div>

        <!-- Reset Button -->
        <div class="flex items-end">
          <a
            href="/admin/review"
            class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
          >
            Reset Filters
          </a>
        </div>
      </form>
    </div>

    <!-- Theses Table -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <% if (theses.length === 0) { %>
        <!-- Empty State -->
        <div class="text-center py-12">
          <svg
            class="mx-auto h-12 w-12 text-gray-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No pending theses</h3>
          <p class="mt-1 text-sm text-gray-500">
            All submissions have been reviewed.
          </p>
        </div>
      <% } else { %>
        <!-- Table -->
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Submitted
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Student
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Title
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Department
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Files
                </th>
                <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% theses.forEach(thesis => {
                const submittedDate = new Date(thesis.submittedAt);
                const formattedDate = submittedDate.toLocaleDateString('id-ID', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                });
                const formattedTime = submittedDate.toLocaleTimeString('id-ID', {
                  hour: '2-digit',
                  minute: '2-digit'
                });
                const truncatedTitle = thesis.title.length > 80 ? thesis.title.substring(0, 80) + '...' : thesis.title;
              %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <!-- Submitted Date -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900"><%= formattedDate %></div>
                    <div class="text-xs text-gray-500"><%= formattedTime %></div>
                  </td>

                  <!-- Student Info -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                      <div class="flex-shrink-0 h-10 w-10">
                        <div class="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center">
                          <span class="text-sm font-medium text-blue-600">
                            <%= thesis.submitter.name.charAt(0).toUpperCase() %>
                          </span>
                        </div>
                      </div>
                      <div class="ml-4">
                        <div class="text-sm font-medium text-gray-900">
                          <%= thesis.submitter.name %>
                        </div>
                        <div class="text-xs text-gray-500">
                          <%= thesis.studentId %>
                        </div>
                      </div>
                    </div>
                  </td>

                  <!-- Title -->
                  <td class="px-6 py-4">
                    <div class="text-sm text-gray-900" title="<%= thesis.title %>">
                      <%= truncatedTitle %>
                    </div>
                    <div class="text-xs text-gray-500 mt-1">
                      Advisor: <%= thesis.advisor1.name %>
                    </div>
                  </td>

                  <!-- Department -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900"><%= thesis.department.name %></div>
                    <div class="text-xs text-gray-500"><%= thesis.department.faculty.name %></div>
                  </td>

                  <!-- Files Count -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      <%= thesis.files.length %> files
                    </span>
                  </td>

                  <!-- Actions -->
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <a
                      href="/admin/review/<%= thesis.id %>"
                      class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
                    >
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                      Review
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Help Text -->
    <% if (theses.length > 0) { %>
      <div class="mt-6 text-center text-sm text-gray-500">
        Showing <%= theses.length %> thesis submissions waiting for review
      </div>
    <% } %>
  </div>
</div>
