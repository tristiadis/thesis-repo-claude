<!-- Lecturer Management Page -->
<div class="space-y-6" x-data="lecturerManager()">

  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">
        <i class="fas fa-chalkboard-teacher text-teal-600 mr-3"></i>Manage Lecturers
      </h1>
      <p class="text-gray-600 mt-1">Manage lecturer information and assignments</p>
    </div>
    <a href="/admin/lecturers/create" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-teal-600 to-cyan-600 text-white font-medium rounded-lg hover:from-teal-700 hover:to-cyan-700 transition shadow-md hover:shadow-lg">
      <i class="fas fa-plus mr-2"></i>Add New Lecturer
    </a>
  </div>

  <!-- Search and Filter -->
  <div class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex items-center space-x-4">
      <div class="flex-1">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-search text-gray-400"></i>
          </div>
          <input
            type="text"
            x-model="searchQuery"
            placeholder="Search lecturers by name or NIDN..."
            class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-2 focus:ring-teal-500 focus:border-transparent"
          >
        </div>
      </div>
      <div class="flex items-center space-x-2 text-sm text-gray-600">
        <span>Showing</span>
        <span class="font-bold text-teal-600" x-text="filteredLecturers.length"></span>
        <span>of</span>
        <span class="font-bold" x-text="lecturers.length"></span>
        <span>lecturers</span>
      </div>
    </div>
  </div>

  <!-- Lecturers Table -->
  <div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <% if (lecturers && lecturers.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                NIDN
              </th>
              <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Name (RIS Format)
              </th>
              <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Email
              </th>
              <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Department
              </th>
              <th scope="col" class="px-6 py-4 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <template x-for="lecturer in filteredLecturers" :key="lecturer.id">
              <tr class="hover:bg-gray-50 transition">
                <td class="px-6 py-4 whitespace-nowrap">
                  <template x-if="lecturer.nidn">
                    <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-teal-100 text-teal-800" x-text="lecturer.nidn"></span>
                  </template>
                  <template x-if="!lecturer.nidn">
                    <span class="text-gray-400 text-sm">-</span>
                  </template>
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
                      <i class="fas fa-user-tie text-teal-600"></i>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900" x-text="lecturer.name"></div>
                      <div class="text-xs text-gray-500">
                        <i class="fas fa-check-circle text-green-500 mr-1"></i>Valid RIS format
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <template x-if="lecturer.email">
                    <div class="flex items-center text-sm text-gray-900">
                      <i class="fas fa-envelope text-gray-400 mr-2"></i>
                      <span x-text="lecturer.email"></span>
                    </div>
                  </template>
                  <template x-if="!lecturer.email">
                    <span class="text-gray-400 text-sm">-</span>
                  </template>
                </td>
                <td class="px-6 py-4">
                  <template x-if="lecturer.department">
                    <div>
                      <div class="text-sm font-medium text-gray-900" x-text="lecturer.department.name"></div>
                      <div class="text-xs text-gray-500" x-text="lecturer.department.faculty.name"></div>
                    </div>
                  </template>
                  <template x-if="!lecturer.department">
                    <span class="text-gray-400 text-sm">Not assigned</span>
                  </template>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                  <a :href="`/admin/lecturers/${lecturer.id}/edit`" class="inline-flex items-center px-3 py-1 border border-blue-300 text-blue-700 rounded-md hover:bg-blue-50 transition">
                    <i class="fas fa-edit mr-1"></i>Edit
                  </a>
                  <button
                    @click="confirmDelete(lecturer)"
                    class="inline-flex items-center px-3 py-1 border border-red-300 text-red-700 rounded-md hover:bg-red-50 transition">
                    <i class="fas fa-trash mr-1"></i>Delete
                  </button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Empty Search Results -->
      <div x-show="filteredLecturers.length === 0 && searchQuery !== ''" class="text-center py-12">
        <i class="fas fa-search text-gray-300 text-5xl mb-4"></i>
        <p class="text-gray-500 text-lg mb-2">No lecturers found</p>
        <p class="text-gray-400 text-sm">Try adjusting your search query</p>
        <button @click="searchQuery = ''" class="mt-4 text-teal-600 hover:text-teal-800 font-medium text-sm">
          Clear Search
        </button>
      </div>

    <% } else { %>
      <!-- Empty State -->
      <div class="text-center py-16">
        <i class="fas fa-chalkboard-teacher text-gray-300 text-6xl mb-4"></i>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No Lecturers Yet</h3>
        <p class="text-gray-500 mb-6">Get started by adding your first lecturer</p>
        <a href="/admin/lecturers/create" class="inline-flex items-center px-6 py-3 bg-teal-600 text-white font-medium rounded-lg hover:bg-teal-700 transition">
          <i class="fas fa-plus mr-2"></i>Add First Lecturer
        </a>
      </div>
    <% } %>
  </div>

  <!-- RIS Format Info Box -->
  <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-xl p-6 border border-teal-200">
    <div class="flex items-start">
      <div class="flex-shrink-0">
        <i class="fas fa-info-circle text-teal-600 text-2xl"></i>
      </div>
      <div class="ml-4">
        <h3 class="text-lg font-bold text-gray-900 mb-2">
          About RIS Name Format
        </h3>
        <p class="text-sm text-gray-700 mb-3">
          All lecturer names must follow the RIS (Reference Information Service) format: <strong>Last, First</strong>
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <div class="bg-white rounded-lg p-3 border border-teal-200">
            <div class="flex items-center mb-2">
              <i class="fas fa-check-circle text-green-500 mr-2"></i>
              <span class="font-semibold text-green-700">Correct Examples:</span>
            </div>
            <ul class="space-y-1 text-gray-700 ml-6">
              <li>• Santoso, Budi</li>
              <li>• Wijaya, Ahmad</li>
              <li>• Kusuma, Siti</li>
            </ul>
          </div>
          <div class="bg-white rounded-lg p-3 border border-red-200">
            <div class="flex items-center mb-2">
              <i class="fas fa-times-circle text-red-500 mr-2"></i>
              <span class="font-semibold text-red-700">Incorrect Examples:</span>
            </div>
            <ul class="space-y-1 text-gray-700 ml-6">
              <li>• Budi Santoso (no comma)</li>
              <li>• Santoso (incomplete)</li>
              <li>• Santoso Budi (reversed)</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div
    x-show="showDeleteModal"
    x-cloak
    class="fixed inset-0 z-50 overflow-y-auto"
    aria-labelledby="modal-title"
    role="dialog"
    aria-modal="true"
    style="display: none;"
  >
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">

      <!-- Background overlay -->
      <div
        x-show="showDeleteModal"
        x-transition:enter="ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"
        aria-hidden="true"
        @click="showDeleteModal = false"
      ></div>

      <!-- Center modal -->
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

      <!-- Modal panel -->
      <div
        x-show="showDeleteModal"
        x-transition:enter="ease-out duration-300"
        x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
        x-transition:leave="ease-in duration-200"
        x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
        x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full"
      >
        <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
          <div class="sm:flex sm:items-start">
            <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
              <i class="fas fa-exclamation-triangle text-red-600"></i>
            </div>
            <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
              <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                Delete Lecturer
              </h3>
              <div class="mt-2">
                <p class="text-sm text-gray-500">
                  Are you sure you want to delete lecturer <strong x-text="lecturerToDelete?.name"></strong>?
                  This action cannot be undone.
                </p>
                <div class="mt-3 p-3 bg-yellow-50 border-l-4 border-yellow-400 rounded">
                  <div class="flex">
                    <i class="fas fa-exclamation-circle text-yellow-400 mt-0.5 mr-2"></i>
                    <p class="text-sm text-yellow-700">
                      Deletion will fail if this lecturer is referenced in any thesis (as advisor or examiner).
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
          <button
            type="button"
            @click="deleteLecturer()"
            :disabled="isDeleting"
            class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span x-show="!isDeleting">
              <i class="fas fa-trash mr-2"></i>Delete
            </span>
            <span x-show="isDeleting" class="flex items-center">
              <i class="fas fa-spinner fa-spin mr-2"></i>Deleting...
            </span>
          </button>
          <button
            type="button"
            @click="showDeleteModal = false"
            :disabled="isDeleting"
            class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- Alpine.js Component -->
<script>
  function lecturerManager() {
    return {
      lecturers: <%= JSON.stringify(lecturers) %>,
      searchQuery: '',
      showDeleteModal: false,
      lecturerToDelete: null,
      isDeleting: false,

      get filteredLecturers() {
        if (!this.searchQuery.trim()) {
          return this.lecturers;
        }

        const query = this.searchQuery.toLowerCase();
        return this.lecturers.filter(lecturer => {
          const name = lecturer.name?.toLowerCase() || '';
          const nidn = lecturer.nidn?.toLowerCase() || '';
          const email = lecturer.email?.toLowerCase() || '';

          return name.includes(query) || nidn.includes(query) || email.includes(query);
        });
      },

      confirmDelete(lecturer) {
        this.lecturerToDelete = lecturer;
        this.showDeleteModal = true;
      },

      async deleteLecturer() {
        if (!this.lecturerToDelete) return;

        this.isDeleting = true;

        try {
          const response = await fetch(`/admin/lecturers/${this.lecturerToDelete.id}/delete`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
          });

          if (response.ok) {
            // Redirect to reload page with flash message
            window.location.href = '/admin/lecturers';
          } else {
            alert('Failed to delete lecturer. Please try again.');
            this.isDeleting = false;
          }
        } catch (error) {
          console.error('Error deleting lecturer:', error);
          alert('An error occurred while deleting the lecturer.');
          this.isDeleting = false;
        }
      }
    }
  }
</script>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
