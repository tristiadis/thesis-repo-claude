<!-- Create Student Account Page -->
<div class="max-w-3xl mx-auto space-y-6" x-data="createUserForm()">

  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">
        <i class="fas fa-user-plus text-blue-600 mr-3"></i><%= pageTitle %>
      </h1>
      <p class="text-gray-600 mt-1">Create a new student account for the thesis repository system</p>
    </div>
    <a href="/admin/users" class="inline-flex items-center px-4 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition">
      <i class="fas fa-arrow-left mr-2"></i>Back to Users
    </a>
  </div>

  <!-- Info Box -->
  <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-lg p-6">
    <div class="flex items-start">
      <i class="fas fa-info-circle text-blue-600 text-2xl mr-3 mt-0.5"></i>
      <div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Creating Student Accounts</h3>
        <ul class="space-y-1 text-sm text-gray-700">
          <li><i class="fas fa-check text-green-500 mr-2"></i>Usernames must be unique and contain no spaces</li>
          <li><i class="fas fa-check text-green-500 mr-2"></i>Passwords can be auto-generated (recommended) or manually set</li>
          <li><i class="fas fa-check text-green-500 mr-2"></i>Credentials will be shown only once after creation</li>
          <li><i class="fas fa-check text-green-500 mr-2"></i>Students can change their password after first login</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Form Card -->
  <div class="bg-white rounded-xl shadow-sm p-8">
    <form
      id="createUserForm"
      action="/admin/users"
      method="POST"
      @submit="handleSubmit"
      novalidate
    >

      <!-- Username - Required -->
      <div class="mb-6">
        <label for="username" class="block text-sm font-semibold text-gray-700 mb-2">
          Username <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="username"
          name="username"
          x-model="form.username"
          @input="validateUsername"
          required
          autofocus
          placeholder="e.g., student001, john.doe"
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          :class="{
            'border-red-500': errors.username,
            'border-green-500': form.username && !errors.username && isUsernameValid,
            'border-gray-300': !form.username
          }"
        >
        <p x-show="errors.username" x-text="errors.username" class="mt-2 text-sm text-red-600"></p>
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Must be unique, lowercase recommended, no spaces
        </p>
      </div>

      <!-- Password Option Selector -->
      <div class="mb-6">
        <label class="block text-sm font-semibold text-gray-700 mb-3">
          Password <span class="text-red-500">*</span>
        </label>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          <!-- Auto-Generate Option -->
          <div
            @click="form.passwordOption = 'auto'; form.password = ''"
            class="relative border-2 rounded-lg p-4 cursor-pointer transition"
            :class="form.passwordOption === 'auto' ? 'border-blue-500 bg-blue-50' : 'border-gray-300 hover:border-blue-300'"
          >
            <input
              type="radio"
              name="passwordOption"
              value="auto"
              x-model="form.passwordOption"
              class="absolute top-4 right-4"
            >
            <div class="flex items-start">
              <div class="flex-shrink-0 w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                <i class="fas fa-magic text-blue-600"></i>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Auto-Generate</h4>
                <p class="text-sm text-gray-600">12-character secure random password</p>
                <span class="text-xs text-green-600 font-medium mt-1 inline-block">
                  <i class="fas fa-shield-alt mr-1"></i>Recommended
                </span>
              </div>
            </div>
          </div>

          <!-- Manual Input Option -->
          <div
            @click="form.passwordOption = 'manual'"
            class="relative border-2 rounded-lg p-4 cursor-pointer transition"
            :class="form.passwordOption === 'manual' ? 'border-blue-500 bg-blue-50' : 'border-gray-300 hover:border-blue-300'"
          >
            <input
              type="radio"
              name="passwordOption"
              value="manual"
              x-model="form.passwordOption"
              class="absolute top-4 right-4"
            >
            <div class="flex items-start">
              <div class="flex-shrink-0 w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center mr-3">
                <i class="fas fa-keyboard text-purple-600"></i>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Manual Input</h4>
                <p class="text-sm text-gray-600">Set a custom password (min 8 chars)</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Manual Password Input (shown only when manual option selected) -->
        <div x-show="form.passwordOption === 'manual'" x-transition class="space-y-4">
          <div class="relative">
            <input
              :type="showPassword ? 'text' : 'password'"
              id="password"
              name="password"
              x-model="form.password"
              @input="checkPasswordStrength"
              placeholder="Enter password (minimum 8 characters)"
              class="w-full px-4 py-3 pr-12 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              :class="{
                'border-red-500': errors.password,
                'border-green-500': form.password && form.password.length >= 8,
                'border-gray-300': !form.password
              }"
            >
            <!-- Show/Hide Password Toggle -->
            <button
              type="button"
              @click="showPassword = !showPassword"
              class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-gray-600"
            >
              <i class="fas" :class="showPassword ? 'fa-eye-slash' : 'fa-eye'"></i>
            </button>
          </div>

          <!-- Password Strength Indicator -->
          <div x-show="form.password" class="space-y-2">
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-600">Password Strength:</span>
              <span class="font-semibold" :class="{
                'text-red-600': passwordStrength === 'Weak',
                'text-yellow-600': passwordStrength === 'Medium',
                'text-green-600': passwordStrength === 'Strong'
              }" x-text="passwordStrength"></span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div
                class="h-2 rounded-full transition-all duration-300"
                :class="{
                  'bg-red-500 w-1/3': passwordStrength === 'Weak',
                  'bg-yellow-500 w-2/3': passwordStrength === 'Medium',
                  'bg-green-500 w-full': passwordStrength === 'Strong'
                }"
              ></div>
            </div>
            <div class="text-xs text-gray-600 space-y-1">
              <div :class="form.password.length >= 8 ? 'text-green-600' : 'text-gray-400'">
                <i class="fas" :class="form.password.length >= 8 ? 'fa-check-circle' : 'fa-circle'"></i>
                At least 8 characters
              </div>
              <div :class="hasUpperCase ? 'text-green-600' : 'text-gray-400'">
                <i class="fas" :class="hasUpperCase ? 'fa-check-circle' : 'fa-circle'"></i>
                Contains uppercase letter
              </div>
              <div :class="hasLowerCase ? 'text-green-600' : 'text-gray-400'">
                <i class="fas" :class="hasLowerCase ? 'fa-check-circle' : 'fa-circle'"></i>
                Contains lowercase letter
              </div>
              <div :class="hasNumber ? 'text-green-600' : 'text-gray-400'">
                <i class="fas" :class="hasNumber ? 'fa-check-circle' : 'fa-circle'"></i>
                Contains number
              </div>
            </div>
          </div>

          <p x-show="errors.password" x-text="errors.password" class="text-sm text-red-600"></p>
        </div>

        <!-- Auto-generate info -->
        <div x-show="form.passwordOption === 'auto'" class="mt-4 p-4 bg-green-50 border-l-4 border-green-500 rounded">
          <div class="flex items-center">
            <i class="fas fa-magic text-green-600 mr-2"></i>
            <p class="text-sm text-green-700 font-medium">
              A secure 12-character password will be automatically generated
            </p>
          </div>
        </div>
      </div>

      <!-- Full Name - Optional -->
      <div class="mb-6">
        <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
          Full Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          x-model="form.name"
          placeholder="e.g., John Doe"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        >
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Optional: Student's full name
        </p>
      </div>

      <!-- Email - Optional -->
      <div class="mb-6">
        <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
          Email Address
        </label>
        <input
          type="email"
          id="email"
          name="email"
          x-model="form.email"
          @input="validateEmail"
          placeholder="e.g., student@example.com"
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          :class="{
            'border-red-500': errors.email,
            'border-green-500': form.email && !errors.email && isEmailValid,
            'border-gray-300': !form.email
          }"
        >
        <p x-show="errors.email" x-text="errors.email" class="mt-2 text-sm text-red-600"></p>
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Optional: Contact email address
        </p>
      </div>

      <!-- Required Fields Notice -->
      <div class="mb-6 p-4 bg-yellow-50 border-l-4 border-yellow-400 rounded">
        <div class="flex">
          <i class="fas fa-exclamation-triangle text-yellow-400 mt-0.5 mr-3"></i>
          <div class="text-sm text-yellow-700">
            <p class="font-medium">Important Reminder</p>
            <p class="mt-1">After creating the account, credentials will be shown ONLY ONCE. Make sure to save them securely!</p>
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="flex items-center justify-end space-x-4 pt-6 border-t border-gray-200">
        <a
          href="/admin/users"
          class="px-6 py-3 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition"
          :class="{'opacity-50 pointer-events-none': isSubmitting}"
        >
          <i class="fas fa-times mr-2"></i>Cancel
        </a>
        <button
          type="submit"
          :disabled="isSubmitting || !canSubmit"
          class="px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-medium rounded-lg hover:from-blue-700 hover:to-indigo-700 transition shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span x-show="!isSubmitting">
            <i class="fas fa-user-plus mr-2"></i>Create Student Account
          </span>
          <span x-show="isSubmitting" class="flex items-center">
            <i class="fas fa-spinner fa-spin mr-2"></i>Creating...
          </span>
        </button>
      </div>

    </form>
  </div>

</div>

<!-- Alpine.js Component -->
<script>
  function createUserForm() {
    return {
      form: {
        username: '',
        passwordOption: 'auto',
        password: '',
        name: '',
        email: ''
      },
      errors: {},
      isSubmitting: false,
      showPassword: false,
      isUsernameValid: false,
      isEmailValid: false,
      passwordStrength: 'Weak',
      hasUpperCase: false,
      hasLowerCase: false,
      hasNumber: false,

      get canSubmit() {
        // Username must be valid
        if (!this.form.username || this.errors.username) {
          return false;
        }

        // If manual password, must be at least 8 chars
        if (this.form.passwordOption === 'manual') {
          if (!this.form.password || this.form.password.length < 8) {
            return false;
          }
        }

        // Email must be valid if provided
        if (this.form.email && this.errors.email) {
          return false;
        }

        return true;
      },

      validateUsername() {
        const username = this.form.username.trim();

        if (!username) {
          this.errors.username = 'Username is required';
          this.isUsernameValid = false;
          return;
        }

        if (username.includes(' ')) {
          this.errors.username = 'Username cannot contain spaces';
          this.isUsernameValid = false;
          return;
        }

        if (username.length < 3) {
          this.errors.username = 'Username must be at least 3 characters';
          this.isUsernameValid = false;
          return;
        }

        delete this.errors.username;
        this.isUsernameValid = true;
      },

      validateEmail() {
        const email = this.form.email.trim();

        if (!email) {
          delete this.errors.email;
          this.isEmailValid = false;
          return;
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          this.errors.email = 'Invalid email format';
          this.isEmailValid = false;
          return;
        }

        delete this.errors.email;
        this.isEmailValid = true;
      },

      checkPasswordStrength() {
        const password = this.form.password;

        this.hasUpperCase = /[A-Z]/.test(password);
        this.hasLowerCase = /[a-z]/.test(password);
        this.hasNumber = /[0-9]/.test(password);

        let strength = 0;
        if (password.length >= 8) strength++;
        if (password.length >= 12) strength++;
        if (this.hasUpperCase) strength++;
        if (this.hasLowerCase) strength++;
        if (this.hasNumber) strength++;
        if (/[^A-Za-z0-9]/.test(password)) strength++; // Special chars

        if (strength <= 2) {
          this.passwordStrength = 'Weak';
        } else if (strength <= 4) {
          this.passwordStrength = 'Medium';
        } else {
          this.passwordStrength = 'Strong';
        }
      },

      handleSubmit(event) {
        // Clear previous errors
        this.errors = {};

        // Validate form
        this.validateUsername();

        if (this.form.passwordOption === 'manual') {
          if (!this.form.password || this.form.password.length < 8) {
            this.errors.password = 'Password must be at least 8 characters';
          }
        }

        if (this.form.email) {
          this.validateEmail();
        }

        // Check if there are any errors
        if (Object.keys(this.errors).length > 0) {
          event.preventDefault();
          return false;
        }

        // Set loading state
        this.isSubmitting = true;

        // Form will submit naturally
        return true;
      }
    }
  }
</script>
