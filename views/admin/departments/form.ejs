<!-- Department Form (Create/Edit) -->
<div class="max-w-3xl mx-auto space-y-6" x-data="departmentForm()">

  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">
        <i class="fas fa-sitemap text-indigo-600 mr-3"></i><%= pageTitle %>
      </h1>
      <p class="text-gray-600 mt-1">
        <%= department ? 'Update department information' : 'Add a new department to a faculty' %>
      </p>
    </div>
    <a href="/admin/departments" class="inline-flex items-center px-4 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition">
      <i class="fas fa-arrow-left mr-2"></i>Back to List
    </a>
  </div>

  <!-- Form Card -->
  <div class="bg-white rounded-xl shadow-sm p-8">
    <form
      id="departmentForm"
      action="<%= action %>"
      method="POST"
      @submit="handleSubmit"
      novalidate
    >

      <!-- Faculty Selection - Required -->
      <div class="mb-6">
        <label for="facultyId" class="block text-sm font-semibold text-gray-700 mb-2">
          Faculty <span class="text-red-500">*</span>
        </label>
        <div class="relative">
          <select
            id="facultyId"
            name="facultyId"
            x-model="form.facultyId"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent appearance-none bg-white"
            :class="{'border-red-500': errors.facultyId}"
          >
            <option value="">-- Select Faculty --</option>
            <% faculties.forEach(faculty => { %>
              <option value="<%= faculty.id %>" <%= department && department.facultyId === faculty.id ? 'selected' : '' %>>
                <%= faculty.name %><% if (faculty.code) { %> (<%= faculty.code %>)<% } %>
              </option>
            <% }); %>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-400">
            <i class="fas fa-chevron-down"></i>
          </div>
        </div>
        <p x-show="errors.facultyId" x-text="errors.facultyId" class="mt-2 text-sm text-red-600"></p>
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Select the faculty this department belongs to
        </p>
      </div>

      <!-- Name (Indonesian) - Required -->
      <div class="mb-6">
        <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
          Department Name (Indonesian) <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          x-model="form.name"
          required
          placeholder="e.g., Teknik Informatika"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          :class="{'border-red-500': errors.name}"
        >
        <p x-show="errors.name" x-text="errors.name" class="mt-2 text-sm text-red-600"></p>
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Enter the official department name in Indonesian
        </p>
      </div>

      <!-- Name (English) - Optional -->
      <div class="mb-6">
        <label for="nameEn" class="block text-sm font-semibold text-gray-700 mb-2">
          Department Name (English)
        </label>
        <input
          type="text"
          id="nameEn"
          name="nameEn"
          x-model="form.nameEn"
          placeholder="e.g., Informatics Engineering"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
        >
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Optional: English translation of the department name
        </p>
      </div>

      <!-- Code - Optional -->
      <div class="mb-6">
        <label for="code" class="block text-sm font-semibold text-gray-700 mb-2">
          Department Code
        </label>
        <input
          type="text"
          id="code"
          name="code"
          x-model="form.code"
          placeholder="e.g., IF"
          maxlength="10"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          :class="{'border-red-500': errors.code}"
        >
        <p x-show="errors.code" x-text="errors.code" class="mt-2 text-sm text-red-600"></p>
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Optional: Short code or abbreviation (max 10 characters)
        </p>
      </div>

      <!-- Description - Optional -->
      <div class="mb-6">
        <label for="description" class="block text-sm font-semibold text-gray-700 mb-2">
          Description
        </label>
        <textarea
          id="description"
          name="description"
          x-model="form.description"
          rows="4"
          placeholder="Enter a brief description of the department..."
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none"
        ></textarea>
        <p class="mt-2 text-sm text-gray-500">
          <i class="fas fa-info-circle mr-1"></i>Optional: Additional information about the department
        </p>
      </div>

      <!-- Required Fields Notice -->
      <div class="mb-6 p-4 bg-blue-50 border-l-4 border-blue-400 rounded">
        <div class="flex">
          <i class="fas fa-info-circle text-blue-400 mt-0.5 mr-3"></i>
          <div class="text-sm text-blue-700">
            <p class="font-medium">Required fields are marked with <span class="text-red-500">*</span></p>
            <p class="mt-1">Department name must be unique within the selected faculty</p>
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="flex items-center justify-end space-x-4 pt-6 border-t border-gray-200">
        <a
          href="/admin/departments"
          class="px-6 py-3 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition"
          :class="{'opacity-50 pointer-events-none': isSubmitting}"
        >
          <i class="fas fa-times mr-2"></i>Cancel
        </a>
        <button
          type="submit"
          :disabled="isSubmitting"
          class="px-6 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-medium rounded-lg hover:from-indigo-700 hover:to-purple-700 transition shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span x-show="!isSubmitting">
            <i class="fas fa-save mr-2"></i><%= department ? 'Update Department' : 'Create Department' %>
          </span>
          <span x-show="isSubmitting" class="flex items-center">
            <i class="fas fa-spinner fa-spin mr-2"></i>Saving...
          </span>
        </button>
      </div>

    </form>
  </div>

  <!-- Help Tips -->
  <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-xl p-6 border border-indigo-200">
    <h3 class="text-lg font-bold text-gray-900 mb-3">
      <i class="fas fa-lightbulb text-yellow-500 mr-2"></i>Tips
    </h3>
    <ul class="space-y-2 text-sm text-gray-700">
      <li class="flex items-start">
        <i class="fas fa-check-circle text-green-500 mr-2 mt-0.5"></i>
        <span>Make sure to select the correct faculty before creating a department</span>
      </li>
      <li class="flex items-start">
        <i class="fas fa-check-circle text-green-500 mr-2 mt-0.5"></i>
        <span>Department names should be clear and follow official naming conventions</span>
      </li>
      <li class="flex items-start">
        <i class="fas fa-check-circle text-green-500 mr-2 mt-0.5"></i>
        <span>Each department code should be unique across all faculties</span>
      </li>
      <li class="flex items-start">
        <i class="fas fa-check-circle text-green-500 mr-2 mt-0.5"></i>
        <span>Provide both Indonesian and English names for better multilingual support</span>
      </li>
    </ul>
  </div>

</div>

<!-- Alpine.js Component -->
<script>
  function departmentForm() {
    return {
      form: {
        facultyId: '<%= department ? department.facultyId : "" %>',
        name: '<%= department ? department.name : "" %>',
        nameEn: '<%= department ? (department.nameEn || "") : "" %>',
        code: '<%= department ? (department.code || "") : "" %>',
        description: '<%= department ? (department.description || "") : "" %>'
      },
      errors: {},
      isSubmitting: false,

      handleSubmit(event) {
        // Clear previous errors
        this.errors = {};

        // Validate form
        if (!this.validateForm()) {
          event.preventDefault();
          return false;
        }

        // Set loading state
        this.isSubmitting = true;

        // Form will submit naturally
        return true;
      },

      validateForm() {
        let isValid = true;

        // Validate faculty selection (required)
        if (!this.form.facultyId || this.form.facultyId === '') {
          this.errors.facultyId = 'Faculty selection is required';
          isValid = false;
        }

        // Validate name (required)
        if (!this.form.name || this.form.name.trim() === '') {
          this.errors.name = 'Department name (Indonesian) is required';
          isValid = false;
        } else if (this.form.name.trim().length < 3) {
          this.errors.name = 'Department name must be at least 3 characters';
          isValid = false;
        }

        // Validate code (optional, but if provided must be valid)
        if (this.form.code && this.form.code.trim() !== '') {
          if (this.form.code.trim().length > 10) {
            this.errors.code = 'Department code must be maximum 10 characters';
            isValid = false;
          }
        }

        // Focus on first error field
        if (!isValid) {
          const firstErrorField = Object.keys(this.errors)[0];
          if (firstErrorField) {
            document.getElementById(firstErrorField)?.focus();
          }
        }

        return isValid;
      }
    }
  }
</script>
