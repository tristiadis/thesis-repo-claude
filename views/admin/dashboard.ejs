<!-- Admin Dashboard Page -->
<div class="space-y-6">

  <!-- Page Header -->
  <div class="bg-white rounded-lg shadow-sm p-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">
      <i class="fas fa-tachometer-alt text-blue-600 mr-3"></i>Admin Dashboard
    </h1>
    <p class="text-gray-600">Welcome to the Thesis Repository Admin Panel</p>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

    <!-- Total Users -->
    <div class="bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition">
      <div class="flex items-center">
        <div class="flex-shrink-0 w-12 h-12 bg-blue-500 rounded-lg flex items-center justify-center">
          <i class="fas fa-users text-white text-xl"></i>
        </div>
        <div class="ml-4 flex-1">
          <p class="text-sm font-medium text-gray-500 mb-1">Total Users</p>
          <p class="text-2xl font-bold text-gray-900">
            <%= typeof stats !== 'undefined' && stats.totalUsers ? stats.totalUsers : '-' %>
          </p>
        </div>
      </div>
    </div>

    <!-- Total Theses -->
    <div class="bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition">
      <div class="flex items-center">
        <div class="flex-shrink-0 w-12 h-12 bg-green-500 rounded-lg flex items-center justify-center">
          <i class="fas fa-file-alt text-white text-xl"></i>
        </div>
        <div class="ml-4 flex-1">
          <p class="text-sm font-medium text-gray-500 mb-1">Total Theses</p>
          <p class="text-2xl font-bold text-gray-900">
            <%= typeof stats !== 'undefined' && stats.totalTheses ? stats.totalTheses : '-' %>
          </p>
        </div>
      </div>
    </div>

    <!-- Pending Review -->
    <div class="bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition">
      <div class="flex items-center">
        <div class="flex-shrink-0 w-12 h-12 bg-yellow-500 rounded-lg flex items-center justify-center">
          <i class="fas fa-clock text-white text-xl"></i>
        </div>
        <div class="ml-4 flex-1">
          <p class="text-sm font-medium text-gray-500 mb-1">Pending Review</p>
          <p class="text-2xl font-bold text-gray-900">
            <%= typeof stats !== 'undefined' && stats.pendingTheses ? stats.pendingTheses : '-' %>
          </p>
        </div>
      </div>
    </div>

    <!-- Approved This Month -->
    <div class="bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition">
      <div class="flex items-center">
        <div class="flex-shrink-0 w-12 h-12 bg-purple-500 rounded-lg flex items-center justify-center">
          <i class="fas fa-check-circle text-white text-xl"></i>
        </div>
        <div class="ml-4 flex-1">
          <p class="text-sm font-medium text-gray-500 mb-1">Approved (Month)</p>
          <p class="text-2xl font-bold text-gray-900">
            <%= typeof stats !== 'undefined' && stats.approvedThisMonth ? stats.approvedThisMonth : '-' %>
          </p>
        </div>
      </div>
    </div>

  </div>

  <!-- Quick Actions -->
  <div class="bg-white rounded-lg shadow-sm p-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">
      <i class="fas fa-bolt text-yellow-500 mr-2"></i>Quick Actions
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/admin/users" class="group flex items-center space-x-3 p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition">
        <i class="fas fa-user-plus text-blue-600 text-xl group-hover:scale-110 transition-transform"></i>
        <span class="font-medium text-gray-700 group-hover:text-blue-700">Manage Users</span>
      </a>

      <a href="/admin/theses/pending" class="group flex items-center space-x-3 p-4 border border-gray-200 rounded-lg hover:border-green-500 hover:bg-green-50 transition">
        <i class="fas fa-tasks text-green-600 text-xl group-hover:scale-110 transition-transform"></i>
        <span class="font-medium text-gray-700 group-hover:text-green-700">Review Theses</span>
      </a>

      <a href="/admin/faculties" class="group flex items-center space-x-3 p-4 border border-gray-200 rounded-lg hover:border-purple-500 hover:bg-purple-50 transition">
        <i class="fas fa-building text-purple-600 text-xl group-hover:scale-110 transition-transform"></i>
        <span class="font-medium text-gray-700 group-hover:text-purple-700">Manage Faculties</span>
      </a>

      <a href="/admin/statistics" class="group flex items-center space-x-3 p-4 border border-gray-200 rounded-lg hover:border-indigo-500 hover:bg-indigo-50 transition">
        <i class="fas fa-chart-bar text-indigo-600 text-xl group-hover:scale-110 transition-transform"></i>
        <span class="font-medium text-gray-700 group-hover:text-indigo-700">View Statistics</span>
      </a>
    </div>
  </div>

  <!-- Recent Activity (Placeholder) -->
  <div class="bg-white rounded-lg shadow-sm p-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">
      <i class="fas fa-history text-gray-500 mr-2"></i>Recent Activity
    </h2>

    <div class="space-y-3">
      <% if (typeof recentActivities !== 'undefined' && recentActivities.length > 0) { %>
        <% recentActivities.forEach(activity => { %>
          <div class="flex items-start space-x-3 p-3 hover:bg-gray-50 rounded-lg transition">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center">
                <i class="fas fa-<%= activity.icon %> text-gray-600"></i>
              </div>
            </div>
            <div class="flex-1">
              <p class="text-sm text-gray-900"><%= activity.message %></p>
              <p class="text-xs text-gray-500 mt-1"><%= activity.time %></p>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="text-center py-8">
          <i class="fas fa-inbox text-gray-300 text-4xl mb-3"></i>
          <p class="text-gray-500">No recent activity</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Info Notice -->
  <div class="bg-blue-50 border-l-4 border-blue-500 rounded-lg p-4">
    <div class="flex items-start">
      <i class="fas fa-info-circle text-blue-600 text-xl mr-3 mt-1"></i>
      <div>
        <h3 class="text-sm font-semibold text-blue-900 mb-1">System Information</h3>
        <p class="text-sm text-blue-800">
          This is Phase 1 (Foundation) of the Thesis Repository System. Full admin functionality will be implemented in later phases.
        </p>
      </div>
    </div>
  </div>

</div>
