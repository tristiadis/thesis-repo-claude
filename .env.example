# Application
NODE_ENV=development
PORT=3000
APP_NAME=Thesis Repository System

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/thesis_repo_db?schema=public

# Session
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
SESSION_MAX_AGE=86400000

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.zip,.rar

# Upload Directories
UPLOAD_DIR=public/uploads
THESIS_UPLOAD_DIR=public/uploads/thesis
PROFILE_UPLOAD_DIR=public/uploads/profiles

# Application URLs
BASE_URL=http://localhost:3000

# Admin Account (for seeding)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com

# Pagination
ITEMS_PER_PAGE=10

# Security
BCRYPT_ROUNDS=10
